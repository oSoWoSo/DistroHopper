function get_() {
	local ARCH="x86"
	local HASH=""
	local ISO=""
	local URL="https://dl.odysseylinux.org"
	case "$RELEASE" in
		launch)
			ISO="odyssey-launch-edition-chapter-II-x86_64.iso.torrent"
			HASH="0194121c9ae4f911101d4c73b2e78a60efb1ebfb449e1dae202c875a66d7e89b"
			;;
		shipwreck)
			ISO="odyssey-shipwreck-x86_64.iso.torrent"
			HASH="a3fddc198a30f8345eb8682ae0ad09aacbf64b3fc7a31db38dfdc0c1c65d099d"
			;;
	esac
	TORRENT="${URL}/${ISO} ${HASH}"
	echo "$TORRENT"
}

function config_() {
	echo "disk_size=\"32G\"" >> "${CONF_FILE}"
}
