# Template file for 'manjaro'
OSNAME="manjaro"
PRETTY="Manjaro"
LOGO=" "
ICON="manjaro.svg"
CATEGORY="Beginner"
BASEDOF="Arch"
HOMEPAGE="https://manjaro.org"
DESCRIPTION="Versatile, free, and open-source Linux operating system designed with a strong focus on safeguarding user privacy and offering extensive control over hardware"
CREDENTIALS="-"
GPG=""
RSS=""
DW=""

function releases_() {
	echo xfce gnome plasma cinnamon i3 sway
}

function editions_() {
	if [[ "${RELEASE}" == sway ]]; then
		echo full
	else
		echo full minimal
	fi
}

function get_() {
	local HASH=""
	local URL=""
	local MANIFEST=""
	local TYPE="official"

	case "${RELEASE}" in
		sway)
			MANIFEST="$(web_pipe https://manjaro-sway.download/iso/)"
			local VERSION
			VERSION=$(printf '%s' "${MANIFEST}" | grep -oE '/iso/[0-9]{12}/' | head -n 1 | awk -F/ '{print $3}')
			[ -n "${VERSION}" ] || return 0
			URL="https://manjaro-sway.download/iso/latest/manjaro-sway.iso"
			HASH=$(web_pipe "https://manjaro-sway.download/iso/${VERSION}/SHA256SUMS" |
				awk '$2 ~ /manjaro-sway-.*[.]iso$/ { print $1; exit }')
			echo "${URL} ${HASH}"
			return 0
			;;
		cinnamon|i3)
			TYPE="community"
			MANIFEST="$(web_pipe https://gitlab.manjaro.org/web/iso-info/-/raw/master/file-info.json)"
			printf '%s' "${MANIFEST}" | jq -e 'type == "object"' >/dev/null 2>&1 || return 0
			local ED=""
			[ "${EDITION}" == "minimal" ] && ED=".minimal"
			URL=$(printf '%s' "${MANIFEST}" |
				jq -r ".${TYPE}.${RELEASE}${ED}.image" 2>/dev/null)
			[[ "${URL}" == null ]] && URL=""
			[ -n "${URL}" ] || return 0
			HASH=$(web_pipe "${URL}.sha512" | cut -d' ' -f1)
			echo "${URL} ${HASH}"
			return 0
			;;
	esac

	local PROJECT="manjarolinux"
	local DESKTOP="${RELEASE}"
	[ "${DESKTOP}" == plasma ] && DESKTOP=kde
	local ROOT="https://sourceforge.net/projects/${PROJECT}/files/${DESKTOP}"
	local PAGE
	local VERSION
	local ISO_LIST
	VERSION=$(web_pipe "${ROOT}/" |
		grep -oE "/projects/${PROJECT}/files/${DESKTOP}/[0-9]+([.][0-9]+)+/" |
		awk -F/ '{print $6}' | sort -Vr | head -n 1)
	[ -n "${VERSION}" ] || return 0

	PAGE=$(web_pipe "${ROOT}/${VERSION}/")
	ISO_LIST=$(printf '%s' "${PAGE}" |
		grep -oE "https://sourceforge.net/projects/${PROJECT}/files/${DESKTOP}/${VERSION}/[^\"[:space:]]+[.]iso/download")
	if [ "${EDITION}" == minimal ]; then
		URL=$(printf '%s\n' "${ISO_LIST}" | grep -F -- '-minimal-' | head -n 1)
	else
		URL=$(printf '%s\n' "${ISO_LIST}" | grep -vF -- '-minimal-' | head -n 1)
	fi
	[ -n "${URL}" ] || return 0
	HASH=$(web_pipe "${URL%/download}.sha512/download" | cut -d' ' -f1)
	echo "${URL} ${HASH}"
}
