# Template file for 'pureos'
OSNAME="pureos"
PRETTY="PureOS"
LOGO=""
ICON="pureos.svg"
ICON_ONLINE="https://distrowatch.com/images/yvzhuwbpy/pureos.png"
CATEGORY="advanced"
