function releases_() {
	echo latest
}

function editions_() {
	echo kde gnome xfce
}

function get_() {
	local DATE
	DATE=$(web_pipe "https://sourceforge.net/projects/noid-linux/rss?path=/" \
		| grep 'title><!\[CDATA' | cut -d'[' -f3 | cut -d']' -f1 \
		| grep "noid-${EDITION}-weekly\.iso" \
		| grep -oE '20[0-9]{6}' | sort -r | head -1)
	local DIR="noid-linux-weekly-${DATE}"
	local ISO="noid-${EDITION}-weekly.iso"
	local URL="https://sourceforge.net/projects/noid-linux/files/${DIR}"
	echo "${URL}/${ISO}"
}

