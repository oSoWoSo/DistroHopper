function releases_() {
	#shellcheck disable=SC2046,SC2005
	web_pipe_json "https://downloads.getsol.us/isos/" | jq -r '.[].name[:-1]' | grep -E "^[0-9-]+$" | sort -u
}

function editions_() {
	# Editions vary between releases (older images use XFCE-Beta, not Xfce).
	local VERSION="${RELEASE:-$(releases_ | tail -n1)}"
	web_pipe_json "https://downloads.getsol.us/isos/${VERSION}/" | jq -r '.[].name | select(endswith(".iso")) | sub("Solus-(?<e>.*)-Release-.*"; "\(.e)")' | sort -u
}

function get_() {
	local HASH=""
	local ISO="Solus-${EDITION}-Release-${RELEASE}.iso"
	local URL="https://downloads.getsol.us/isos/${RELEASE}"
	HASH=$(web_pipe "${URL}/${ISO}.sha256sum" | cut -d' ' -f1)
	echo "${URL}/${ISO} ${HASH}"
}
