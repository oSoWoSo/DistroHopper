function editions_() {
	# desktop version now installs different desktop environments
	echo desktop handheld
}

function get_() {
	local HASH=""
	local URL=""
	URL="$(web_pipe "https://cachyos.org/download/" | grep -o "https://iso.cachyos.org/${EDITION}/[^&]*\.iso" | head -1)"
	HASH=$(web_pipe "${URL}.sha256" | cut -d' ' -f1)
	echo "${URL} ${HASH}"
}

function config_() {
	echo "disk_size=\"64G\"" >> "${CONF_FILE}"
}
