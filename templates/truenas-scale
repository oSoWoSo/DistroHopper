function get_() {
	local HASH=""
	local URL=""
	local BASE="https://download.sys.truenas.net/TrueNAS-SCALE-${RELEASE}"
	local VERSION
	VERSION=$(web_pipe "${BASE}/" | grep -oE '[0-9]+\.[0-9]+\.[0-9.]+/' | tr -d '/' | sort -Vr | head -1)
	[ -n "${VERSION}" ] || return 0
	URL="${BASE}/${VERSION}/TrueNAS-SCALE-${VERSION}.iso"
	HASH=$(web_pipe "${URL}.sha256" | grep -oE '[[:xdigit:]]{64}' | head -1)
	echo "${URL} ${HASH}"
}

function config_() {
	echo "boot=\"legacy\"" >> "${CONF_FILE}"
}
