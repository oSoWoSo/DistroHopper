function releases_() {
	echo latest
}

function editions_() {
	echo en_US ro_RO
}

function get_() {
	local URL="https://sourceforge.net/projects/brgv-os/files/brgv-os/${EDITION}"
	local ISOname
	ISOname=$(web_pipe "https://sourceforge.net/projects/brgv-os/rss?path=/${EDITION}" \
		| grep 'title><!\[CDATA' | cut -d'[' -f3 | cut -d']' -f1 \
		| grep "/${EDITION}/" | grep '\.iso' \
		| cut -d'/' -f3 | sed 's/\.iso$//' | head -1)
	local ISO="${ISOname}.iso"
	local HASH
	HASH=$(web_pipe "${URL}/${ISOname}.sha256")
	echo "${URL}/${ISO} ${HASH}"
}

