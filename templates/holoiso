function releases_() {
	echo latest
}

function get_() {
	local HASH=""
	local URL=""
	RELEASE="$(web_pipe "https://github.com/HoloISO/releases/releases" | grep -o -e 'releases/tag/[[:digit:]]\+\(\.[[:digit:]]\+\)*' | head -n 1 | cut -d'/' -f 3)"
	URL=$(web_pipe "https://api.github.com/repos/HoloISO/releases/releases" | jq -r ".[] | select(.tag_name==\"${RELEASE}\") | .body" | grep -o "https://[^ ]*holoiso\.ru\.eu\.org/[^ ]*\.iso" | head -n 1)
	echo "${URL} ${HASH}"
}
