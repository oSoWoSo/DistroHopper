function releases_() {
	# Get latest release tag from GitHub, strip 'v' prefix
	local latest_tag
	latest_tag=$(web_pipe "https://api.github.com/repos/blend-os/blendOS/releases/latest" | grep -o '"tag_name": "[^"]*"' | cut -d'"' -f4)
	if [[ -n "$latest_tag" ]]; then
		# Remove leading 'v' if present (e.g., v23.06 -> 23.06)
		echo "${latest_tag#v}"
	else
		# Fallback to latest
		echo "latest"
	fi
}

function get_() {
	local version="${RELEASE}"
	local ISO="blendOS-${version}-x86_64-gnome.iso"
	local URL="https://images.blendos.co/track/gnome/${ISO}"
	local HASH=""
	# Get SHA256 hash from the SHA256SUMS file
	HASH=$(web_pipe "${URL}.sha256" 2>/dev/null | grep "${ISO}" | cut -d' ' -f1)
	# If hash not found, try without .sha256 extension (some hosts use SHA256SUMS file)
	if [[ -z "$HASH" ]]; then
		HASH=$(web_pipe "https://images.blendos.co/track/gnome/SHA256SUMS" 2>/dev/null | grep "${ISO}" | cut -d' ' -f1)
	fi
	echo "${URL} ${HASH}"
}
