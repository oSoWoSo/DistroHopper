function get_() {
	local ISO
	ISO=$(web_pipe "https://sourceforge.net/projects/abeiros/rss?path=/" \
		| grep 'title><!\[CDATA' | cut -d'[' -f3 | cut -d']' -f1 | grep '\.iso' | head -1 | cut -d'/' -f3)
	local URL="https://sourceforge.net/projects/abeiros/files/PLASMA"
	echo "${URL}/${ISO}"
}
