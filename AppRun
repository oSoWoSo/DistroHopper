#!/bin/sh
# AppImage entry point for DistroHopper
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="$HERE"
export APPIMAGE="${APPIMAGE:-$HERE}"
export PATH="$HERE/bin:$HERE:$PATH"
cd "$HERE" || exit 1
# Source quick-sharun hooks (self-updater, etc.) when present.
if [ -f "$HERE/AppRun.lib" ]; then
	. "$HERE/AppRun.lib"
	for hook in "$HERE"/bin/*.hook; do
		[ -e "$hook" ] || continue
		. "$hook"
	done
fi
exec "$HERE/bin/dh" "$@"