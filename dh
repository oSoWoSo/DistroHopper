#!/usr/bin/env bash

function wayland_check() {
	if [ -n "$XDG_SESSION_ID" ]; then
		session_type=$(loginctl show-session "$XDG_SESSION_ID" -p Type 2>$DH_NULL | cut -d= -f2)
	else
		session_type=""
	fi
	case "$session_type" in
	wayland)
		export GDK_BACKEND=x11
		echo "Running on Wayland"
		;;
	x11)
		echo "Running on X"
		;;
	"")
		echo "Running on TTY"
		;;
	*)
		echo "Not sure where I am running"
		;;
	esac
}

SCRIPT_DIR="${APPDIR:-$(dirname "$(realpath "$0")")}"

# Get OS description from template files
# For ready VMs (e.g. "ubuntu-24.04"), progressively strips release suffix
# to find the matching template ("ubuntu"). Falls back to empty string.
get_os_description() {
	local name="$1" candidate
	# Try exact match first (for supported VMs where name == OS name)
	if [ -f "${SCRIPT_DIR}/templates/${name}" ]; then
		OS="$name" bash -c "source '${SCRIPT_DIR}/templates/${name}' >$DH_NULL 2>$DH_NULL; echo \$DESCRIPTION" 2>$DH_NULL
		return
	fi
	# Progressive strip for ready VMs (e.g. "ubuntu-budgie-24.04" → "ubuntu")
	candidate="$name"
	while [ -n "$candidate" ]; do
		next="${candidate%-*}"
		[ "$next" = "$candidate" ] && break
		candidate="$next"
		if [ -f "${SCRIPT_DIR}/templates/${candidate}" ]; then
			OS="$candidate" bash -c "source '${SCRIPT_DIR}/templates/${candidate}' >$DH_NULL 2>$DH_NULL; echo \$DESCRIPTION" 2>$DH_NULL
			return
		fi
	done
	# Last chance: whatever candidate remains (handles no-hyphen names).
	if [ -n "$candidate" ] && [ -f "${SCRIPT_DIR}/templates/${candidate}" ]; then
		OS="$candidate" bash -c "source '${SCRIPT_DIR}/templates/${candidate}' >$DH_NULL 2>$DH_NULL; echo \$DESCRIPTION" 2>$DH_NULL
		return
	fi
	echo ""
}

root=""
function root_check() {
	if [ "$(id -u)" != 0 ]; then
		if [ -f /usr/bin/sudo ]; then
			echo "$(tput bold)INFO: Using sudo for root operations.$(tput sgr0)"
			root="sudo"
		elif [ -f /usr/bin/doas ]; then
			echo "$(tput bold)INFO: Using doas for root operations.$(tput sgr0)"
			root="doas"
		fi
	fi
}

function set_variables() {
	# DEBUG mod
	#bash -x ./dh 2>&1 | tee output.log
	#progname="${progname:="${0##*/}"}"
	progname="DistroHopper"
	export GDK_CORE_DEVICE_EVENTS=1
	version="0.93"
	#GTK_THEME="alt-dialog"
	DH_CONFIG_DIR="${HOME}/.config/dh"
	DH_CONFIG="${DH_CONFIG_DIR}/config"
	DH_ICON_DIR="${DH_CONFIG_DIR}/icons"

	if [[ -n "${APPDIR:-}" ]]; then
		PATH_PREFIX="${APPDIR}/bin/"
	else
		PATH_PREFIX="/usr/bin/"
	fi
	TMP_DIR="/tmp"
	# The terminal emulator the desktop entry opens. "true" means no
	# terminal, which is the safe default: an entry naming a terminal that
	# is not installed does not start.
	terminal="false"
	# shellcheck disable=SC2089
	replace='"!"'
	VMS_DIR="${HOME}/vm"
	RAMDISK="no"
	RAMDISK_DIR="/dev/shm/quickemu"
	ISO_DIR=""
	USE_TEMPLATES="no"
	if [ -f "${DH_CONFIG}" ]; then
		# shellcheck source=/dev/null
		. "${DH_CONFIG}"
	fi
	[ -n "${VMS_DIR}" ] || VMS_DIR="${HOME}/vm"
	[ -n "${RAMDISK}" ] || RAMDISK="no"
	[ -n "${RAMDISK_DIR}" ] || RAMDISK_DIR="/dev/shm/quickemu"
	[ -n "${USE_TEMPLATES}" ] || USE_TEMPLATES="no"
	# Fall back to templates when the (generated) public/ metadata is absent,
	# e.g. in a source/AppImage checkout that only ships templates/.
	if [ "${USE_TEMPLATES}" != "yes" ] && [ ! -d "${SCRIPT_DIR}/public" ] && [ -d "${SCRIPT_DIR}/templates" ]; then
		USE_TEMPLATES="yes"
	fi
	[ -n "${terminal}" ] || terminal="true"
	if [ "${USE_TEMPLATES}" == "yes" ]; then
		export DH_USE_TEMPLATES="yes"
	fi
	# shellcheck disable=SC2090
	export DH_CONFIG_DIR DH_CONFIG replace DH_ICON_DIR PATH_PREFIX TMP_DIR terminal VMS_DIR RAMDISK RAMDISK_DIR ISO_DIR USE_TEMPLATES
	#check_and_set_mode
	# Set traps to catch the signals and exit gracefully
	trap "exit" INT
}

# installation ---------------------------------------------------------

function dependencies_check_gui() {
	[ -f "${PATH_PREFIX}/yad" ] || echo "Yad not installed!"
}

function install_needed_apt() {
	$root apt install qemu bash coreutils ovmf grep jq lsb procps python3 genisoimage usbutils util-linux sed spice-client-gtk swtpm wget xdg-user-dirs zsync unzip yad
}

function install_needed_pacman() {
	$root pacman -S cdrtools coreutils edk2-ovmf grep jq procps python3 qemu-full sed socat spice-gtk swtpm usbutils util-linux wget xdg-user-dirs xorg-xrandr zsync getext yad
}

function install_needed_xbps() {
	$root xbps-install -S qemu bash coreutils grep jq procps-ng python3 util-linux sed spice-gtk swtpm usbutils wget xdg-user-dirs xrandr unzip zsync socat yad
}

function install_needed_dnf() {
	$root dnf install qemu bash coreutils edk2-tools grep jq lsb procps python3 genisoimage usbutils util-linux sed spice-gtk-tools swtpm wget xdg-user-dirs xrandr unzip yad
}

function install_dependencies() {
	# Find the current distribution and install dependecies
	if [ -f /etc/os-release ]; then
		if [ -f "${PATH_PREFIX}/pacman" ]; then
			install_needed_pacman
		elif [ -f "${PATH_PREFIX}/apt" ]; then
			install_needed_apt
		elif [ -f "${PATH_PREFIX}/xbps-install" ]; then
			install_needed_xbps
		elif [ -f "${PATH_PREFIX}/dnf" ]; then
			install_needed_dnf
		else
			echo "Error unknown distro!"
			#exit 1
		fi
	fi
}

function create_dirs() {
	mkdir -p "${DH_CONFIG_DIR}"
	touch "${DH_CONFIG}"
	mkdir -p "${DH_ICON_DIR}"
	mkdir -p "${DH_CONFIG_DIR}/supported"
	mkdir -p "${DH_CONFIG_DIR}/ready"
}

function save_config() {
	local temp_config
	mkdir -p "${DH_CONFIG_DIR}" || return 1
	temp_config=$(mktemp "${DH_CONFIG}.XXXXXX") || return 1
	{
		printf 'VMS_DIR=%q\nexport VMS_DIR\n' "${VMS_DIR}"
		printf 'RAMDISK=%q\nexport RAMDISK\n' "${RAMDISK}"
		printf 'RAMDISK_DIR=%q\nexport RAMDISK_DIR\n' "${RAMDISK_DIR}"
		printf 'ISO_DIR=%q\nexport ISO_DIR\n' "${ISO_DIR}"
		printf 'USE_TEMPLATES=%q\nexport USE_TEMPLATES\n' "${USE_TEMPLATES}"
	} >"${temp_config}" || {
		rm -f "${temp_config}"
		return 1
	}
	mv -f "${temp_config}" "${DH_CONFIG}"
	echo "Config saved: ${DH_CONFIG}"
}

function choose_vms_dir() {
	local new_dir
	new_dir="$(yad --width=900 --height=900 --file --directory \
		--title="Where to save VMs?" --filename="${VMS_DIR}")" || return 1
	[ -n "${new_dir}" ] || return 1
	VMS_DIR="${new_dir}"
	export VMS_DIR
	save_config
	echo "VMs directory set to: ${VMS_DIR}"
}

function set_vms_directory() {
	echo "[dh] Set VMs directory..."
	local old_dir="${VMS_DIR}"
	choose_vms_dir || return
	[ "${VMS_DIR}" == "${old_dir}" ] && return
	renew_ready_vms
	renew_supported_vms
}

function set_ramdisk() {
	echo "[dh] RAM disk..."
	local output enabled ramdisk_dir
	output="$(yad --title="RAM disk" --form --separator=$'\t' \
		--field="Create VM disk in RAM (tmpfs)":CHK \
		--field="RAM disk directory":DIR \
		"$([ "${RAMDISK}" == "yes" ] && echo TRUE || echo FALSE)" "${RAMDISK_DIR}")" || return 1
	enabled="${output%%$'\t'*}"
	ramdisk_dir="${output#*$'\t'}"
	[ "${output}" != "${enabled}" ] || return 1
	case "${enabled}" in
		TRUE) RAMDISK="yes" ;;
		FALSE) RAMDISK="no" ;;
		*) return 1 ;;
	esac
	[ -n "${ramdisk_dir}" ] || return 1
	RAMDISK_DIR="${ramdisk_dir}"
	export RAMDISK RAMDISK_DIR
	save_config || return 1
	echo "RAM disk: ${RAMDISK} (${RAMDISK_DIR})"
	yad --title="RAM disk" --width=400 \
		--text="$([ "${RAMDISK}" == "yes" ] && echo "RAM disk enabled: ${RAMDISK_DIR}" || echo "RAM disk disabled")"
}


DH_VERSION_FILE=""
function install_dh() {
	if [[ -n "${APPDIR:-}" ]]; then
		echo "Running from AppImage: installation is not required."
		return 0
	fi
	DH_VERSION_FILE="${DH_CONFIG_DIR}/version"
	local install_type="fresh"

	if [ -f "${DH_VERSION_FILE}" ]; then
		local old_version
		old_version=$(cat "${DH_VERSION_FILE}")
		if [ "${old_version}" != "${version}" ]; then
			install_type="upgrade"
			echo "Upgrading DistroHopper ${old_version} → ${version}"
		else
			install_type="reinstall"
			echo "DistroHopper ${version} already installed"
		fi
	else
		echo "Installing DistroHopper ${version}"
	fi

	cp -f "${SCRIPT_DIR}"/{generate,qget,q,dh,quickemu,quickreport,chunkcheck,lib.sh} "${PATH_PREFIX}" >$DH_NULL 2>$DH_NULL || \
		$root cp -f "${SCRIPT_DIR}"/{generate,qget,q,dh,quickemu,quickreport,chunkcheck,lib.sh} "${PATH_PREFIX}"
	cp -f "${SCRIPT_DIR}"/dh-refresh "${PATH_PREFIX}" >$DH_NULL 2>$DH_NULL || \
		$root cp -f "${SCRIPT_DIR}"/dh-refresh "${PATH_PREFIX}"
	mkdir -p "${PATH_PREFIX}/public" "${PATH_PREFIX}/templates" >$DH_NULL 2>$DH_NULL || $root mkdir -p "${PATH_PREFIX}/public" "${PATH_PREFIX}/templates"
	cp -f "${SCRIPT_DIR}"/public/* "${PATH_PREFIX}/public/" >$DH_NULL 2>$DH_NULL || $root cp -f "${SCRIPT_DIR}"/public/* "${PATH_PREFIX}/public/"
	cp -f "${SCRIPT_DIR}"/templates/* "${PATH_PREFIX}/templates/" >$DH_NULL 2>$DH_NULL || $root cp -f "${SCRIPT_DIR}"/templates/* "${PATH_PREFIX}/templates/"
	if [ -d "${SCRIPT_DIR}/icons" ]; then
		cp -f "${SCRIPT_DIR}"/icons/* "${DH_ICON_DIR}/" >$DH_NULL 2>$DH_NULL || $root cp -f "${SCRIPT_DIR}"/icons/* "${DH_ICON_DIR}/"
	fi
	mkdir -p "${DH_CONFIG_DIR}/ready"
	mkdir -p "${DH_CONFIG_DIR}/supported"
	echo "${version}" > "${DH_VERSION_FILE}"
}

# shellcheck disable=SC2154
function create_desktop_entry() {
	cat <<EOF > "${DESKTOP_FILE}"
[Desktop Entry]
Version=${version}
Type=${type}
Name=${name}
GenericName=${gname}
Comment=${comment}
Exec=${execmd}
Icon=${icon}
Terminal=${terminal}
X-MultipleArgs=${args}
Type=${type}
Categories=${categories}
StartupNotify=${notify}
MimeType=${mime}
Keywords=${keyword}

EOF
	chmod +x "${DESKTOP_FILE}"
}

# shellcheck disable=SC2269
function desktop_entry_dh() {
	DESKTOP_FILE="${TMP_DIR}/dh.desktop"
	type='Application'
	name='DistroHopper'
	comment='Quickly download, create and run VM of any operating system.'
	version="${version}"
	execmd="sh -c 'cd ${VMS_DIR} && dh'"
	icon="${DH_ICON_DIR}/hop.png"
	categories='System;X-Virtualization;'
	export -f create_desktop_entry
	create_desktop_entry
	$root cp "${TMP_DIR}/dh.desktop" /usr/share/applications/
}

function installation_process() {
	dependencies_check_gui
	install_dependencies
	create_dirs
	choose_vms_dir
	install_dh
	desktop_entry_dh
}

# basic ----------------------------------------------------------------

run_in_terminal() {
	if [ -t 1 ] || [ "${DH_DEBUG:-}" = "1" ]; then
		interminal="yes"
	else
		interminal="no"
	fi
}
# shellcheck disable=SC2269
function renew_ready_vms() {
	echo "[dh] Renew ready..."
	# YAD field actions run in separate bash processes, so reload persisted
	# settings to pick up a VM directory chosen after the GUI was opened.
	if [ -f "${DH_CONFIG}" ]; then
		# shellcheck source=/dev/null
		. "${DH_CONFIG}"
	fi
	# The VMs are read from VMS_DIR, but the working directory is restored
	# afterwards: a later relative path (e.g. ./qget) would otherwise be
	# resolved inside the VMs directory.
	local _old_dir="${PWD}"
	cd "${VMS_DIR}" || { echo "ERROR: VMS_DIR not set!"; exit 1; }
	rm -f "${DH_CONFIG_DIR}/ready"/*.desktop >$DH_NULL 2>$DH_NULL
	mkdir -p "${DH_CONFIG_DIR}/ready"
	for vm_conf in *.conf; do
		[ -f "${vm_conf}" ] || continue
		[ "${vm_conf}" = "distrohopper.conf" ] && continue
		VMname=$(basename "${VMS_DIR}/${vm_conf}" .conf)
		echo "${VMname}.desktop"
		# Use fuzzy matching to find the best matching icon file (ready to run VMs)
		icon_name=$(basename "${VMS_DIR}/${vm_conf}" .conf | cut -d'-' -f -2)
		icon_file=$(find "${DH_ICON_DIR}" -type f -iname "${icon_name// /}.*")
		# If no icon was found, try shorter name (ready to run VMs)
		if [ -z "${icon_file}" ]; then
			icon_name=$(basename "${VMS_DIR}/${vm_conf}" .conf | cut -d'-' -f1)
			icon_file=$(find "${DH_ICON_DIR}" -type f -iname "${icon_name// /}.*")
		fi
		if [ -z "${icon_file}" ]; then
			icon_file="${DH_ICON_DIR}/tux.svg"
		fi
		DESKTOP_FILE="${DH_CONFIG_DIR}/ready/${VMname}.desktop"
		type='Application'
		name="${VMname}"
		# Try quickget for a more accurate description (old version approach)
		comment=$("${SCRIPT_DIR}/qget" --show --plain "${VMname}" 2>$DH_NULL | grep 'Description' | sed 's/^Description:[[:space:]]*//')
		[ -z "${comment}" ] && comment=$(get_os_description "${VMname}")
		version="${version}"
		execmd="sh -c 'cd ${VMS_DIR} && quickemu -vm ${vm_conf};$SHELL'"
		icon="${icon_file}"
		categories='System;X-Virtualization;'
		create_desktop_entry
	done
	cd "${_old_dir}" || true
	find "${DH_CONFIG_DIR}/ready" -type f -name '*.desktop' -exec chmod +x {} + 2>/dev/null || true
	echo "[dh] Renew ready complete"
}
function renew_supported_vms() {
	echo "[dh] Renew supported..."
	local qget_cmd os_info release_edition_options release_edition_opts_fmt icon_source
	# Refresh the user icon cache before rebuilding supported desktop entries.
	# New icons added to the repository are otherwise missed until reinstall.
	icon_source="${SCRIPT_DIR}/icons"
	if [ -d "${icon_source}" ]; then
		cp -f "${icon_source}"/* "${DH_ICON_DIR}/" >$DH_NULL 2>$DH_NULL || $root cp -f "${icon_source}"/* "${DH_ICON_DIR}/"
	fi
	# The repository copy first, then the installed one. The paths are
	# absolute so the lookup does not depend on the current directory.
	if [ -x "${SCRIPT_DIR}/qget" ]; then
		qget_cmd="${SCRIPT_DIR}/qget"
	elif [ -x "${PATH_PREFIX}/qget" ]; then
		qget_cmd="${PATH_PREFIX}/qget"
	else
		qget_cmd="qget"
	fi

	rm -f "${DH_CONFIG_DIR}/supported"/*.desktop >$DH_NULL 2>$DH_NULL
	mkdir -p "${DH_CONFIG_DIR}/supported" >$DH_NULL 2>$DH_NULL
	"$qget_cmd" --list-os >"${DH_CONFIG_DIR}/supported.md" 2>$DH_NULL
	if [ ! -s "${DH_CONFIG_DIR}/supported.md" ]; then
		echo "WARNING: qget --list-os produced no entries" >&2
	fi
	while read -r get_name; do
		VMname=$(echo "${get_name}" | tr ' ' '_')
		os_info=$("$qget_cmd" --show --plain "${VMname}" 2>$DH_NULL)
		releases=$(printf '%s\n' "${os_info}" | awk -F: '$1 ~ /^[[:space:]]*Releases[[:space:]]*$/ {sub(/^[^:]*:[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); print; exit}')
		editions=$(printf '%s\n' "${os_info}" | awk -F: '$1 ~ /^[[:space:]]*Editions[[:space:]]*$/ {sub(/^[^:]*:[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); print; exit}')
		# The editions one per line. An edition can contain a space (e.g.
		# "Brazilian Portuguese"), so the space separated value above cannot
		# be split apart again — this list can.
		editions_list=$(printf '%s\n' "${os_info}" | sed -n '/^EditionsList:$/,$p' | sed '1d; /^$/d; /^Description:/,$d; /^RSS:/,$d; /^DistroWatch:/,$d')
		architectures=$(printf '%s\n' "${os_info}" | awk -F: '$1 ~ /^[[:space:]]*(Archs|Architectures)[[:space:]]*$/ {sub(/^[^:]*:[[:space:]]*/, ""); sub(/[[:space:]]*$/, ""); print; exit}')
		# Resolve the icon from the template's ICON field (not the OS name),
		# since icon filenames do not always match OS names (e.g. lmde).
		template_file="${SCRIPT_DIR}/templates/${VMname}"
		if [ ! -f "${template_file}" ]; then
			candidate="${VMname}"
			while [ -n "${candidate}" ]; do
				next="${candidate%-*}"
				[ "${next}" = "${candidate}" ] && break
				candidate="${next}"
				if [ -f "${SCRIPT_DIR}/templates/${candidate}" ]; then
					template_file="${SCRIPT_DIR}/templates/${candidate}"
					break
				fi
			done
		fi
		tmpl_icon=""
		if [ -f "${template_file}" ]; then
			tmpl_icon=$(OS="${VMname}" bash -c "source '${template_file}' >/dev/null 2>&1; printf '%s' \"\${ICON:-}\"" 2>/dev/null)
		fi
		if [ -n "${tmpl_icon}" ] && [ -f "${DH_ICON_DIR}/${tmpl_icon}" ]; then
			icon_file="${DH_ICON_DIR}/${tmpl_icon}"
		elif [ -f "${DH_ICON_DIR}/${VMname}.svg" ]; then
			icon_file="${DH_ICON_DIR}/${VMname}.svg"
		elif [ -f "${DH_ICON_DIR}/${VMname}.png" ]; then
			icon_file="${DH_ICON_DIR}/${VMname}.png"
		else
			icon_file="${DH_ICON_DIR}/tux.svg"
		fi
		echo "${VMname}.desktop"
		# Check if there are editions
		DESKTOP_FILE="${DH_CONFIG_DIR}/supported/${VMname}.desktop"
		type="Application"
		name="${get_name}"
		arch_opts="${architectures:-x86_64}"
		arch_opts_fmt=$(echo "$arch_opts" | tr ' ' '!')
		release_edition_options=""
		if [ "$(echo "$arch_opts" | wc -w)" -gt 1 ]; then
			local selected_arch selected_release selected_edition arch_info release_info arch_releases arch_editions
			for selected_arch in ${arch_opts}; do
				arch_info=$("$qget_cmd" --show --plain --arch "${selected_arch}" "${VMname}" 2>$DH_NULL)
				arch_releases=$(printf '%s\n' "${arch_info}" | sed -n 's/^Releases:[[:space:]]*//p')
				[ -z "$arch_releases" ] && arch_releases="${releases}"
				arch_editions=$(printf '%s\n' "${arch_info}" | sed -n 's/^Editions:[[:space:]]*//p')
				arch_editions_list=$(printf '%s\n' "${arch_info}" | sed -n '/^EditionsList:$/,$p' | sed '1d; /^$/d; /^Description:/,$d; /^RSS:/,$d; /^DistroWatch:/,$d')
				for selected_release in ${arch_releases}; do
					release_info=$("$qget_cmd" --show --plain --arch "${selected_arch}" --release "${selected_release}" "${VMname}" 2>$DH_NULL)
					release_editions=$(printf '%s\n' "${release_info}" | sed -n 's/^Editions:[[:space:]]*//p')
					release_editions_list=$(printf '%s\n' "${release_info}" | sed -n '/^EditionsList:$/,$p' | sed '1d; /^$/d; /^Description:/,$d; /^RSS:/,$d; /^DistroWatch:/,$d')
					[ -z "$release_editions_list" ] && release_editions_list="${arch_editions_list:-$editions_list}"
					# The editions are read line by line, so an edition that
					# contains a space stays one entry.
					if [ -z "${release_editions_list}" ]; then
						# Distro has no editions for this release/arch: still
						# offer the (arch, release) combination.
						release_edition_options+="${selected_arch};${selected_release}; "
					else
						while IFS= read -r selected_edition; do
							[ -n "$selected_edition" ] || continue
							release_edition_options+="${selected_arch};${selected_release};${selected_edition} "
						done <<< "${release_editions_list}"
					fi
				done
			done
		elif [ "${VMname}" == "kde-neon" ] && [ -f "${SCRIPT_DIR}/public/${VMname}" ]; then
			local selected_release selected_edition release_editions
			for selected_release in ${releases}; do
				release_editions=$(RELEASE="${selected_release}" ARCH="${arch_opts%% *}" bash -c '. "$1"; editions_' _ "${SCRIPT_DIR}/public/${VMname}")
				for selected_edition in ${release_editions}; do
					release_edition_options+="${selected_release}-${selected_edition} "
				done
			done
		fi
		release_edition_opts_fmt=$(echo "${release_edition_options}" | tr ' ' '!')
		if [ -z "$editions" ] && [ "$(echo "$arch_opts" | wc -w)" -le 1 ]; then
			execmd="bash -c 'mkdir -p \"${VMS_DIR}\"; cd \"${VMS_DIR}\" || exit; choice=\$(GDK_BACKEND=x11 yad --form --separator=\"|\" --field=\"Architecture:CB\" \"${arch_opts_fmt}\" --field=\"Release:CB\" \"${releases// /$replace}\"); [ -n \"\$choice\" ] || exit 0; IFS=\"|\" read -r arch release <<< \"\$choice\"; ${qget_cmd} --arch \"\$arch\" \"${get_name}\" \"\$release\"'"
		elif [ "$interminal" = "yes" ]; then
			terminal="false"
		elif [ "$(echo "$arch_opts" | wc -w)" -gt 1 ]; then
			execmd="bash -c 'mkdir -p \"${VMS_DIR}\"; cd \"${VMS_DIR}\" || exit; choice=\$(GDK_BACKEND=x11 yad --form --field=\"Architecture / Release / Edition:CB\" \"${release_edition_opts_fmt}\"); [ -n \"\$choice\" ] || exit 0; IFS=\";\" read -r arch release edition <<< \"\$choice\"; ${qget_cmd} --arch \"\$arch\" \"${get_name}\" \"\$release\" \"\$edition\"'"
		elif [ "${VMname}" == "kde-neon" ]; then
			execmd="bash -c 'mkdir -p \"${VMS_DIR}\"; cd \"${VMS_DIR}\" || exit; choice=\$(GDK_BACKEND=x11 yad --form --separator=\"|\" --field=\"Architecture:CB\" \"${arch_opts_fmt}\" --field=\"Release / edition:CB\" \"${release_edition_opts_fmt}\"); [ -n \"\$choice\" ] || exit 0; arch=\${choice%%|*}; release_edition=\${choice#*|}; release=\${release_edition%%-*}; edition=\${release_edition#*-}; ${qget_cmd} --arch \"\$arch\" \"${get_name}\" \"\$release\" \"\$edition\"'"
		else
			# The editions are joined with the "!" separator of the yad
			# combobox, so an edition that contains a space stays one entry.
			local editions_fmt
			editions_fmt=$(printf '%s\n' "${editions_list}" | tr '\n' ' ' | tr ' ' '!')
			execmd="bash -c 'mkdir -p \"${VMS_DIR}\"; cd \"${VMS_DIR}\" || exit; choice=\$(GDK_BACKEND=x11 yad --form --separator=\"|\" --field=\"Architecture:CB\" \"${arch_opts_fmt}\" --field=\"Release:CB\" \"${releases// /$replace}\" --field=\"Edition:CB\" \"${editions_fmt}\"); [ -n \"\$choice\" ] || exit 0; IFS=\"|\" read -r arch release edition <<< \"\$choice\"; ${qget_cmd} --arch \"\$arch\" \"${get_name}\" \"\$release\" \"\$edition\"'"
		fi
		icon="${icon_file}"
		# Try quickget for a more accurate description (old version approach)
		comment=$("${SCRIPT_DIR}/qget" --show --plain "${get_name}" 2>$DH_NULL | grep 'Description' | sed 's/^Description:[[:space:]]*//')
		[ -z "${comment}" ] && comment=$(get_os_description "${get_name}")
		categories='System;X-Virtualization;'
		create_desktop_entry
	done < "${DH_CONFIG_DIR}/supported.md"
	find "${DH_CONFIG_DIR}/supported" -type f -name '*.desktop' -exec chmod +x {} + 2>/dev/null || true
	echo "[dh] Renew supported complete"
}

