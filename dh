function help_show() {
	echo "[dh] Help..."
	local help_text
	help_text="$(cat <<EOF
DistroHopper v. ${version}

Quick start:
  ./dh i && dh s g

Arguments:
  h  help             Show this help
  d  dir              Set VMs directory
  i  install          Install DistroHopper
  m  mode             Set mode (tui/gui)
  s  supported        Manage supported VMs
  r  ready            Manage ready-to-run VMs
  l  language         Switch language

Architecture:
  Multi-architecture systems offer compatible architecture and edition
