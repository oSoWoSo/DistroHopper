function set_iso_dir() {
	echo "[dh] ISO dir..."
	local output status
	if [ -n "${ISO_DIR}" ]; then
		yad --title="ISO directory" --width=400 \
			--text="Shared ISO directory: ${ISO_DIR}" \
			--button="Change":0 --button="Disable sharing":1
		status=$?
		case "${status}" in
			0) ;;
			1)
				ISO_DIR=""
				export ISO_DIR
				save_config
				echo "ISO directory sharing disabled"
				return
				;;
			*) return 1 ;;
		esac
	fi
	output="$(yad --title="ISO directory" --file --directory --width=900 --height=900 \
		--text="Choose shared ISO directory" --button="OK":0 --button="Cancel":1 \
		--filename="${ISO_DIR:-${VMS_DIR}}")" || return 1
	[ -n "${output}" ] || return 1
	ISO_DIR="${output}"
	export ISO_DIR
	save_config
	echo "ISO directory set to: ${ISO_DIR}"
}

function set_use_templates() {
	echo "[dh] Metadata source..."
	local output
	output="$(yad --title="Metadata source" --form --separator=$'\t' \
		--field="Read releases and editions from templates (live) instead of the generated public/ files":CHK \
		"$([ "${USE_TEMPLATES}" == "yes" ] && echo TRUE || echo FALSE)")" || return 1
	output="${output//[[:space:]]/}"
	case "${output}" in
		TRUE) USE_TEMPLATES="yes" ;;
		FALSE) USE_TEMPLATES="no" ;;
		*) echo "Metadata source: cancelled/unknown (${output})"; return 1 ;;
	esac
	echo "Metadata source selected: ${output}"
	export USE_TEMPLATES
	if [ "${USE_TEMPLATES}" == "yes" ]; then
		export DH_USE_TEMPLATES="yes"
	else
		unset DH_USE_TEMPLATES
	fi
	save_config || return 1
	echo "Metadata source changed to: ${USE_TEMPLATES}"
	echo "Metadata source: $([ "${USE_TEMPLATES}" == "yes" ] && echo templates || echo public)"
	yad --title="Metadata source" --width=520 \
		--text="$([ "${USE_TEMPLATES}" == "yes" ] && echo "Using templates/: releases and editions are looked up live, which needs network access and is slower." || echo "Using public/: releases and editions come from the generated metadata, which works offline.")"
}

