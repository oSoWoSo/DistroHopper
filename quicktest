# A rather brutal way to turn the VM off and on again
function t_reboot_vm() {
    t_echo "🔃 Rebooting the VM"
    t_send_command "system_reset"
}

# This powers off the VM, and should really only be used
# at the end when cleaning up.
function t_poweroff_vm() {
    t_echo "🔌 Powering off the VM"
    # Qemu has a 'system_powerdown' command but that seems broken (qemu bug 1410)
    # t_send_command "system_powerdown"
    # So for now we'll manually kill the machine but this is not ideal (quickemu bug 1195)
    local quickemu_pid=""
    quickemu_pid="${QUICKEMU_VM_DIR}/${VMNAME}/${VMNAME}.pid"
    if [ -e "$quickemu_pid"  ]; then
        if ! kill $(cat "$quickemu_pid"); then
            t_echo "🚨 Failed to power off the VM"
            exit 1
        else
            rm "$quickemu_pid"
        fi
    fi
}

# DistroHopper: strip the QMP socket line we appended to the VM .conf for
# absolute mouse support, so the next plain quickemu run is unaffected.
function t_uninject_qmp() {
    if [ -n "${T_QMP_CONF_APPENDED:-}" ] && [ -n "${T_QMP_SOCKET:-}" ]; then
        # Escape / and & for the sed address
        local esc
        esc=$(printf '%s' "${T_QMP_SOCKET}" | sed 's/[\/&]/\\&/g')
        sed -i "/${esc}/d" "${T_QMP_CONF_APPENDED}" 2>/dev/null || true
        T_QMP_CONF_APPENDED=""
    fi
}

###
### KEYBOARD - functions to manipulate the VM keyboard
###

# This sends a key-combo like ctrl-alt-delete or 
# meta_l-up to maximise a window
function t_send_key_combo() {
    local key_combo="$1"
    t_echo "⌨️ «$key_combo»"
    local qemu_cmd="sendkey $key_combo"
    #echo "$qemu_cmd | $QEMU_SOCKET_COMMAND"
    echo "$qemu_cmd" | $QEMU_SOCKET_COMMAND > /dev/null
    # Be nice if we detected if the key combo was successful, rather 
    # than have a timeout. But that's a problem for another day.
    sleep "$QEMU_INSERT_DELAY"
}

 # This similar but only sends a single key and references the
 # keys look up list to map the legend on the key to the names
 # by which qemu knows them.
 # e.g. M is shift-m.
 function t_send_key() {
    local key_name="$1"
    # Don't send empty keypresses
    if [ ! "$key_name" == "" ]; then
        local qemu_key_name="${KEYS[$key_name]}"
        local qemu_cmd="sendkey $qemu_key_name"
        t_echo "⌨️ «$key_name»"
        #echo "$qemu_cmd | $QEMU_SOCKET_COMMAND"
        echo "$qemu_cmd" | $QEMU_SOCKET_COMMAND > /dev/null
        # Be nice if we detected if the key combo was successful, rather 
        # than have a timeout. But that's a problem for futur popey.
        sleep "$QEMU_INSERT_DELAY"
    fi
}

# Useful for typing in a word, or a command, or a password
function t_send_string() {
    local input_string="$1"
    while IFS= read -r -n1 char; do
        t_send_key "$char"
    done <<< "$input_string"
}

# A simple helper that types the string and then presses return key
function t_send_string_return() {
    local input_string="$1"
    t_echo "⌨️ «$input_string» then «RETURN»"
    t_send_string "$input_string"
    t_send_key_combo "ret"
}

# Function to send a series of keypresses followed by tab key
function t_send_string_tab() {
    local input_string="$1"
    t_echo "⌨️ Typing «$input_string» then «TAB»"
    t_send_string "$input_string"
    t_send_key_combo "tab"
}

function t_send_command() {
    local qemu_full_cmd="$1"
    local qemu_cmd="$(echo $qemu_full_cmd | awk '{print $1}')"
    local qemu_arg="$(echo $qemu_full_cmd | awk '{print $2}')"
    # This may or may not expaand to be useful if we use some other
    # weird qemu commands which have parameters. But for now, it's
    # just a switch statement with two cases.
    case "$qemu_cmd" in
        screendump)
            qemu_cmd="$qemu_cmd $(basename "$qemu_arg")"
            ;;
        *)
            t_echo " "
            ;; 
    esac
    # This was informational but a bit much in log output
    # t_echo "ℹ️ Inserting command «$qemu_cmd»"
    if ! echo "$qemu_full_cmd" | $QEMU_SOCKET_COMMAND > /dev/null; then
        t_echo "🚨 qemu command failed"
        exit 1
    fi
}

###
### MOUSE - functions to manipulate the VM mouse
###

# Send a raw mouse payload to qemu. In absolute mode the payload is JSON for
# the QMP socket (with the qmp_capabilities handshake), otherwise HMP commands
# for the -monitor socket. DistroHopper: command strings are generated by the
# t_mouse_cmd_* helpers from lib.sh so they stay unit-testable.
function t_mouse_send() {
    local payload="${1}"
    if [ "${T_MOUSE_MODE}" == "absolute" ]; then
        if [ -z "${QMP_SOCKET_COMMAND:-}" ]; then
            t_echo "🚨 QMP socket is not available. Absolute mouse requires the VM to be launched via quicktest with T_MOUSE_MODE=absolute."
            return 1
        fi
        {
            printf '{"execute":"qmp_capabilities"}\n'
            printf '%s\n' "${payload}"
        } | $QMP_SOCKET_COMMAND > /dev/null 2>&1
    else
        if [ -z "${QEMU_SOCKET_COMMAND:-}" ]; then
            t_echo "🚨 QEMU socket is not available."
            return 1
        fi
        printf '%s\n' "${payload}" | $QEMU_SOCKET_COMMAND > /dev/null 2>&1
    fi
    sleep "$QEMU_INSERT_DELAY"
}

# Move the mouse relative (HMP) or to absolute coordinates (QMP).
function t_mouse_move() {
    t_echo "🖱️ Move mouse to ${1}, ${2}"
    t_mouse_send "$(t_mouse_cmd_move "$1" "$2")"
}

# Press or release a mouse button: left, right or middle.
function t_mouse_button() {
    t_echo "🖱️ ${1} button ${2}"
    t_mouse_send "$(t_mouse_cmd_button "$1" "$2")"
}

# Click a mouse button at the current position.
function t_mouse_click() {
    t_echo "🖱️ Click ${1:-left}"
    t_mouse_send "$(t_mouse_cmd_click "${1:-left}")"
}

# Move the mouse to a position and click there in one go.
function t_mouse_click_at() {
    t_echo "🖱️ Click ${3:-left} at ${1}, ${2}"
    t_mouse_send "$(t_mouse_cmd_move "$1" "$2")
$(t_mouse_cmd_click "${3:-left}")"
}

# Click in the top right corner of the VM display. Only meaningful in
# absolute mode (the default quickemu tablet mouse ignores relative moves).
function t_mouse_click_top_right() {
    local btn="${1:-left}"
    if [ "${T_MOUSE_MODE}" != "absolute" ]; then
        t_echo "⚠️ t_mouse_click_top_right only works in absolute mode (T_MOUSE_MODE=absolute). Ignoring."
        return 1
    fi
    t_mouse_click_at "$((QUICKEMU_WIDTH - 1))" 0 "${btn}"
}

### SCREENSHOT - functions to take screenshots and search for text

function t_screenshot_ppm() {
    local test_name="$1"
    # Increment the screenshot counter, so we can keep track of them in
    # sequence
    T_SCREENSHOT_COUNT=$((T_SCREENSHOT_COUNT+1))
    local screenshot_count
    screenshot_count=$(printf "%04d" $T_SCREENSHOT_COUNT)
    local ppmname="$T_RESULTS"/screenshot_"$screenshot_count"_"$test_name".ppm
    t_echo "📷 $(basename $ppmname)"
    t_send_command "screendump $ppmname"
    # Make sure ppm file actually exists after the above command
    if [ ! -f "$ppmname" ]; then
        t_test_fail "🚨 Screenshot failed"
    fi
}

function t_run_tesseract() {
    local ocrimage="$1"
    local ocrtext="$2"
    if ! $TESSERACT -l "$TESSERACT_LANG" "$ocrimage" "$ocrtext" $TESSERACT_OCR_OPTIONS ; then
        t_test_fail "🚨 OCR failed"
    fi
}

function t_grep_screenshot_text() {
    local searchterm="$1"
    local screenshot_count="$2"
    local ocrtext="$3"
    t_echo "🔍 «$searchterm» in screenshot «$screenshot_count»"
    if ! grep -q "$searchterm" "$ocrtext"; then
        t_echo "❌ «$searchterm»"
        return 1
    else
        t_echo "✅ «$searchterm»"
        return 0
    fi
}

function t_search_screenshot() {
    local test_name="$1"
    local searchterm="$2"
    local screenshot_count
    screenshot_count=$(printf "%04d" $T_SCREENSHOT_COUNT)
    local dumpedimage="$T_RESULTS"/screenshot_"$screenshot_count"_"$test_name"
    # The text file generated by tesseract lives in the same results folder and is
    # named the same as the screenshot, but with a .txt extension
    local ocrtext=$dumpedimage
    # If we need to scale the image (to make it easier for tesseract to find things)
    # then we do that here. We scale by 300% by default, but this can be overridden
    if [ "$T_SCALE_IMAGE" == "0" ]; then
        # We aren't scaling, so just use the original image as captured
        # Tesseract adds the .txt suffix when creating output files.
        t_run_tesseract "$dumpedimage.ppm" "$ocrtext"
    else
        local scaledimage="${dumpedimage}_x3"
        if ! $T_SCALE_COMMAND "$dumpedimage".ppm -scale "$T_SCALE_IMAGE" "$scaledimage.ppm"; then
            t_echo "🚨 Image scaling failed"
            exit 1
        else
            # Image was scaled, so we need to OCR the scaled image
            # Tesseract adds the .txt suffix when creating output files.
            t_run_tesseract "$scaledimage.ppm" "$ocrtext"
            # We don't keep the scaled image, so we delete it now
            rm "$scaledimage.ppm"
        fi
    fi
    t_grep_screenshot_text "$searchterm" "$screenshot_count" "$ocrtext.txt"
}

function t_ocr_only() {
    local test_name="$1"
    # Scans the previous screenshot, without looking for specific text
    local screenshot_count
    screenshot_count=$(printf "%04d" $T_SCREENSHOT_COUNT)
    local ppmname="$T_RESULTS"/screenshot_"$screenshot_count"_"$test_name".ppm
    local ppmx3name="$T_RESULTS"/screenshot_"$screenshot_count"_"$test_name"_x3.ppm
    local txtname="$T_RESULTS"/screenshot_"$screenshot_count"_"$test_name"

    if ! $T_SCALE_COMMAND "$ppmname" -scale 300% "$ppmx3name"; then
        t_echo "🚨 Image scaling failed"
        exit 1
    fi
    if ! $TESSERACT -l "$TESSERACT_LANG" "$ppmx3name" "$txtname" $TESSERACT_OCR_OPTIONS ; then
        t_echo "🚨 OCR failed"
        exit 1
    fi
    # Delete the 3x screenshot as we don't need it
    rm "$ppmx3name"
}


# Load in the actual test case we're about to launch
function t_source_quicktest_scripts() {
    if [ ! -f "${T_TESTCASES_DIR}"/"${OS}"/"${RELEASE}${EDITIONPATH}"/"${TESTCASE}" ]; then
        t_echo "🚨 Test case ${TESTCASE} does not exist for ${OS}-${RELEASE}${EDITIONSUFFIX}."
        exit 1
    fi
    if source "${T_TESTCASES_DIR}"/"${OS}"/"${RELEASE}${EDITIONPATH}"/"${TESTCASE}"; then
        t_echo "✅ Source quicktest scripts succeeded."
        return 0
    else
        t_echo "🚨 Source quicktest scripts failed."
        return 1
    fi
}

# Launch qget to download the ISO and create the disk image
# If the disk image already exists, we still run this, as it will
# update the disk image if the ISO has changed (in some cases)
# It also checks the checksum of thet_test_fail ISO
function t_launch_qget() {
    t_echo "🚀 qget ${OS} ${RELEASE} ${EDITION} in ${QUICKEMU_VM_DIR}"
    pushd "${QUICKEMU_VM_DIR}" > /dev/null || return 1
    # DistroHopper: for non-native architectures pass --arch so qget fetches
    # the right ISO and writes a matching <os>-<release>-<arch>.conf.
    if [ "${ARCH}" != "${NORMALISED_HOST_ARCH}" ]; then
        t_echo "ℹ️ Requesting ${ARCH} architecture"
        if ! $QGET --arch "${ARCH}" "${OS}" "${RELEASE}" "${EDITION}"; then
            return 1
        fi
    elif ! $QGET "${OS}" "${RELEASE}" "${EDITION}"; then
        return 1
    fi
    t_echo "✅ qget succeeded."
    popd > /dev/null || return 1
    return 0
}

# Launch quickemu to start the VM
function t_launch_quickemu() {
    t_echo "🚀 Launch quickemu ${VMNAME}.conf in ${QUICKEMU_VM_DIR}"
    pushd "${QUICKEMU_VM_DIR}" > /dev/null || return 1
    # Check to see if it's already running
    if [ -e "${VMNAME}/${VMNAME}.pid" ]; then
        # Do we care though?
        # If T_DISABLE_VM_RUNNING_ERROR is true then we don't care, so issue a warning, wait and continue
        if $T_DISABLE_VM_RUNNING_ERROR ; then
            t_echo "▶️ VM is already running as expected. Continuing."
            t_wait_for_seconds "$T_VM_WARNING_TIMEOUT"
        else
            t_echo "⚠️ VM is already running. Stopping test case"
            t_test_fail "VM is already running"
        fi
    fi
    # Check if the disk image exists and already likely contains an OS
    if [ -f "${VMNAME}/disk.qcow2" ]; then
        t_echo "🖴 Disk image exists"
        local disk_size_units=$(qemu-img info "${VMNAME}/disk.qcow2" | grep ^disk | awk -F ' ' '{print $4}')
        # Check if it's likely to contain data (based on the arbitrary size being at least 1GiB)
        if [ "$disk_size_units" == "GiB" ]; then
            # Do we care though?
            if $T_DISABLE_DISK_WARNING ; then
                t_echo "🖴 Disk image likely contains data. Continuing."
            else
                t_echo "⚠️ ${VMNAME}/disk.qcow2 likely contains data"
                t_wait_for_seconds "$T_DISK_WARNING_TIMEOUT"
            fi
        fi
    else
        t_echo "✅ Disk image does not yet exist."
    fi
    # By default we have network connection, but we may disable that for some tests
    if ! $QUICKEMU_NETWORK; then
        t_echo "🚨 Network is disabled"
        QUICKEMU_OPTS="${QUICKEMU_OPTS} --offline"
    fi
    # DistroHopper: for absolute mouse support we need a QMP socket, which the
    # quickemu HMP-only -monitor does not provide. Inject a QMP socket through
    # the .conf's extra_args line and remember to strip it again afterwards.
    if [ "${T_MOUSE_MODE}" == "absolute" ]; then
        T_QMP_SOCKET="${QUICKEMU_VM_DIR}/${VMNAME}/${VMNAME}-qmp.socket"
        if ! grep -q "${T_QMP_SOCKET}" "${VMNAME}.conf" 2>/dev/null; then
            printf 'extra_args=" -qmp unix:%s,server=on,wait=off "\n' "${T_QMP_SOCKET}" >> "${VMNAME}.conf"
            T_QMP_CONF_APPENDED="${QUICKEMU_VM_DIR}/${VMNAME}.conf"
        fi
    fi
    if ! $QUICKEMU $QUICKEMU_OPTS --display "$QUICKEMU_DISPLAY" --width "$QUICKEMU_WIDTH" --height "$QUICKEMU_HEIGHT" --vm "${VMNAME}".conf; then
        # this is due to https://github.com/quickemu-project/quickemu/issues/1170
        # fixed in later releases
        # Once quickemu is updated we remove popd and change to return 1
        # popd > /dev/null || return 1
        return 0 
    else
        popd > /dev/null || return 1
        return 0
    fi
}

# We use the socket to inject keypresses into qemu, and reboot it
# Let's make sure the socket exists, and if it does, we'll use socat as
# the command to do the injection
# https://gist.github.com/mvidner/8939289
function t_get_qemu_socket() {
    local qemu_socket="${QUICKEMU_VM_DIR}/${VMNAME}/${VMNAME}-monitor.socket"
    local qemu_socket_rel=$(realpath -s --relative-to=$PWD $qemu_socket)
    if [ ! -S "${qemu_socket_rel}" ]; then
        t_echo "🚨 QEMU socket is not found."
        return 1
    else
        t_echo "ℹ️ QEMU socket is ${qemu_socket_rel}"
        #QEMU_SOCKET_COMMAND="nc -N -U $QEMU_SOCKET"
        # Now using socat, which seems decent, but it puts all kinds of 
        # garbage on the screen. We'll redirect it to /dev/null
        # It might be qemu, not socat, but whatever.
        QEMU_SOCKET_COMMAND="$SOCAT - unix-connect:$qemu_socket_rel" > /dev/null
    fi
    # DistroHopper: also wire up the QMP socket for absolute mouse control
    # when it was injected into the VM .conf.
    if [ "${T_MOUSE_MODE}" == "absolute" ] && [ -n "${T_QMP_SOCKET}" ]; then
        local qmp_socket_rel
        qmp_socket_rel=$(realpath -s --relative-to=$PWD "$T_QMP_SOCKET")
        if [ ! -S "${qmp_socket_rel}" ]; then
            t_echo "🚨 QMP socket is not found (${qmp_socket_rel})."
            return 1
        fi
        t_echo "ℹ️ QMP socket is ${qmp_socket_rel}"
        QMP_SOCKET_COMMAND="$SOCAT - unix-connect:${qmp_socket_rel}"
    fi
    return 0
}

function t_load_texts() {
    # Load the texts for the current language
    local lang="${T_TESTCASES_DIR}"/"${OS}"/"${RELEASE}${EDITIONPATH}"/i18n/"$T_TEST_LANG"
    if [ -e "$lang" ]; then
        source "$lang"
        t_echo "✅ Load texts succeeded."
        return 0
    else
        t_echo "🚨 Load texts failed."
        return 1
    fi
}

# Load in the key map things for Qemu.
function t_load_keys() {
    if [ -f "${T_KEYMAPS_DIR}/${T_TEST_LANG}" ]; then
        source "${T_KEYMAPS_DIR}/${T_TEST_LANG}"
        t_echo "✅ Load keys succeeded."
        return 0
    else
        return 1
    fi
}

# Here we actually launch the test case. 
function t_launch_testcase() {
    t_echo "🚀 Launch test case ${OS}/${RELEASE}${EDITIONPATH}/${TESTCASE}"
    "$TESTCASE"
}

function t_write_summary_log() {
    local emoji="$1"
    if [ ! $T_SUMMARY_LOG == "" ]; then
        local t_end_time=$(date +%Y%m%d-%H%M%S)
        echo "$emoji ${T_START_TIME} ${t_end_time} ${OS} ${RELEASE} ${EDITIONPATH} ${TESTCASE}"  >> "$T_SUMMARY_LOG"
        if $T_NOTIFY ; then
            "$T_NOTIFY_SEND" "quicktest" "${emoji} ${OS} ${RELEASE} ${EDITIONPATH} ${TESTCASE}"
        fi        
    fi

}

# The standard place we end up when stuff fails. We then spit out the function name
# that last called, and a link to the log and the results directory
function t_test_fail() {
    t_echo "🚨 Test failed."
    t_echo "Last error in: $1"
    t_echo "🪵 $T_FULL_LOG"
    t_echo "📁 $T_RESULTS"
    if $T_OPEN_RESULTS ; then
        xdg-open "$T_RESULTS"
    fi
    t_uninject_qmp
    t_poweroff_vm
    t_write_summary_log "🚨 FAIL "
    exit 99
}

# Sometimes the tests pass. This is where we end up when that happens
function t_test_pass() {
    t_echo "🪵 $T_FULL_LOG"
    t_echo "📁 $T_RESULTS"
    t_echo "🎉 Test passed: $1"
    if $T_OPEN_RESULTS ; then
        xdg-open "$T_RESULTS"
    fi
    t_write_summary_log "🎉 PASS "
}

# This is where we clean up after ourselves. We optionally make a timelapse video from the screenshots
function t_cleanup() {
    t_echo "🧼 Cleanup"
    pushd "$T_RESULTS" > /dev/null || return 1
    if $T_CREATE_TIMELAPSE ; then
        t_echo "📹 Making video"
        if ! $FFMPEG -hide_banner -loglevel error -framerate 1/3 -pattern_type glob -i 'screenshot_*.ppm' -c:v libx264 -pix_fmt yuv420p "$T_TIMELAPSE_VIDEO"; then
            t_echo "🚨 ffmpeg failed"
        fi 
    fi
    if $T_KEEP_SCREENSHOTS ; then
        t_echo "ℹ️ Keeping images as requested"
    else
        t_echo "ℹ️ Removing images as requested"
        rm screenshot_*.ppm
    fi
    if $T_KEEP_TESSERACT_TEXT ; then
        t_echo "ℹ️ Keeping text files as requested"
    else
        t_echo "ℹ️ Removing text files as requested"
        rm screenshot_*.txt
    fi
    popd > /dev/null || return 1
    t_uninject_qmp
}

