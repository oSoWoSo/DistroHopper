# Take command line arguments
# The -a/--arch flag may be given before the positional arguments.
while [ $# -gt 0 ]; do
    case "${1}" in
    --list-tests|-ls)
        t_list_tests
        exit;;
    -version|--version|-v)
        echo "quicktest ${VERSION}"
        exit;;
    -a|--arch)
        T_ARCH="${2}"
        shift 2
        continue
        ;;
    -h|--h|-help|--help)
        t_usage
        exit;;
    *)
        break
        ;;
    esac
done

if [ -z "${1:-}" ]; then
    t_usage
    exit 0
fi

TESTCASE="${1}"
if [ -z "$(find "${T_TESTCASES_DIR}" -type f -name "${TESTCASE}")" ]; then
    echo "🚨 Test case ${TESTCASE} does not exist."
    exit 1
fi
shift

OS=${1:-"ubuntu"}
shift

RELEASE=${1:-"24.04"}
shift

EDITION=${1:-""}

# DistroHopper: resolve the downloader, preferring this project's qget,
# then qget from PATH, then a vendored qget in the script dir.
resolver_qget() {
    if command -v qget > /dev/null 2>&1; then
        command -v qget
    elif [ -x "${SCRIPT_DIR}/qget" ]; then
        echo "${SCRIPT_DIR}/qget"
    #elif command -v quickget > /dev/null 2>&1; then
    #    command -v quickget
    #elif [ -x "${SCRIPT_DIR}/quickget" ]; then
    #    echo "${SCRIPT_DIR}/quickget"
    fi
}

# DistroHopper: resolve quickemu, preferring the PATH, then a vendored copy
# in the script dir.
resolver_quickemu() {
    if command -v quickemu > /dev/null 2>&1; then
        command -v quickemu
    elif [ -x "${SCRIPT_DIR}/quickemu" ]; then
        echo "${SCRIPT_DIR}/quickemu"
    fi
}

# Check for required commands
if $T_CREATE_TIMELAPSE && ! FFMPEG=$(command -v ffmpeg); then
    echo "🚨 ffmpeg is not found."
    exit 1
fi
if ! SOCAT=$(command -v socat); then
    echo "🚨 socat is not found."
    exit 1
fi
if ! TESSERACT=$(command -v tesseract); then
    # In Void Linux is tesseract command only tesseract-ocr
    if ! TESSERACT=$(command -v tesseract-ocr); then
        echo "🚨 tesseract is not found."
        exit 1
    fi
fi
QUICKEMU=$(resolver_quickemu)
if [ -z "${QUICKEMU}" ]; then
    echo "🚨 quickemu is not found."
    exit 1
else
    QUICKEMU_VER_LONG=$($QUICKEMU --version)
    
    # Check if QUICKEMU_VER_LONG is at least the minimum required QUICKEMU_MIN_VERSION
    if [[ $QUICKEMU_VER_LONG =~ ([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
        QUICKEMU_VER_MAJOR="${BASH_REMATCH[1]}"
        QUICKEMU_VER_MINOR="${BASH_REMATCH[2]}"
        QUICKEMU_VER_PATCH="${BASH_REMATCH[3]}"

        if [[ $QUICKEMU_MIN_VERSION =~ ([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
        QUICKEMU_MIN_MAJOR="${BASH_REMATCH[1]}"
        QUICKEMU_MIN_MINOR="${BASH_REMATCH[2]}"
        QUICKEMU_MIN_PATCH="${BASH_REMATCH[3]}"
        else
            echo "🚨 quickemu version $QUICKEMU_MIN_VERSION is not valid."
            exit 1
        fi

        if [[ $QUICKEMU_VER_MAJOR -lt $QUICKEMU_MIN_MAJOR ]] || \
           [[ $QUICKEMU_VER_MAJOR -eq $QUICKEMU_MIN_MAJOR && $QUICKEMU_VER_MINOR -lt $QUICKEMU_MIN_MINOR ]] || \
           [[ $QUICKEMU_VER_MAJOR -eq $QUICKEMU_MIN_MAJOR && $QUICKEMU_VER_MINOR -eq $QUICKEMU_MIN_MINOR && $QUICKEMU_VER_PATCH -lt $QUICKEMU_MIN_PATCH ]]; then
            echo "🚨 quickemu version $QUICKEMU_MIN_VERSION or newer is required."
            exit 1
        fi
    else
        echo "🚨 quickemu version $QUICKEMU_VER_LONG is not valid."
        exit 1
    fi
fi
if $T_NOTIFY; then
    if ! T_NOTIFY_SEND=$(command -v notify-send); then
        echo "🚨 notify-send is not found."
    fi
fi
QGET=$(resolver_qget)
if [ -z "${QGET}" ]; then
    echo "🚨 No qget found."
    exit 1
fi

# Set edition suffix if needed
if [ ! "${EDITION}" == "" ]; then
    EDITIONSUFFIX="-${EDITION}"
    EDITIONPATH="/${EDITION}"
else
    EDITIONSUFFIX=""
    EDITIONPATH=""
fi

# DistroHopper: normalise host/target architectures and compute the VM name.
# Foreign-arch VMs get a "-<arch>" suffix (see arch_suffix() in lib.sh),
# which qget also applies when writing the .conf, creating the VM dir/socket
# and naming the disk image. Works standalone when lib.sh is unavailable.
NORMALISED_HOST_ARCH="$(uname -m)"
case "${NORMALISED_HOST_ARCH}" in
    aarch64|arm64) NORMALISED_HOST_ARCH="arm64" ;;
    *)             NORMALISED_HOST_ARCH="amd64" ;;
esac
if command -v _host_arch > /dev/null 2>&1; then
    NORMALISED_HOST_ARCH="$(_host_arch)"
fi
ARCH="${T_ARCH:-$NORMALISED_HOST_ARCH}"
if command -v arch_suffix > /dev/null 2>&1; then
    ARCH_SUFFIX="$(arch_suffix)"
else
    ARCH_SUFFIX=""
fi
VMNAME="${OS}-${RELEASE}${EDITIONSUFFIX}${ARCH_SUFFIX}"

# DistroHopper: results base honours ~/.config/dh/config (RESULTS_DIR) when
# present; falls back to the VMs directory's results folder.
if command -v expand_results_dir > /dev/null 2>&1; then
    T_RESULTS_BASE="$(expand_results_dir)"
else
    T_RESULTS_BASE="$(pwd)/results"
fi
T_RESULTS="${T_RESULTS_BASE}/${OS}/${RELEASE}${EDITIONPATH}/${TESTCASE}/${T_START_TIME}"
T_FULL_LOG="$T_RESULTS/$T_LOG"

if  ! mkdir -p "$T_RESULTS";  then
    echo "🚨 Failed to create results directory."
    exit 1
fi

# We source the quicktest scripts, because they may override sett
if ! t_source_quicktest_scripts; then
    echo "🚨 Source quicktest scripts failed."
    exit 1
fi

# Start logging
if ! t_start_logging ; then
    echo "🚨 Start logging failed."
    exit 1
fi

# We start by running whatever is necessary to configure the test
# This function lives inside the test, and it maybe change 
# qget or quickemu launch settings, so that's why we run it here.
if ! test_setup; then
    echo "🚨 Test setup failed."
    exit 1
fi

# Run qget to get (or check) the install image
if ! $T_QGET_SKIP; then 
    if ! t_launch_qget; then
        echo "🚨 qget failed."
        exit 1
    fi
else
    echo "ℹ️ Skipping qget"
fi

# Launch the VM
if ! t_launch_quickemu; then
    echo "🚨 quickemu failed."
    exit 1
fi

# Obtain the socket from Qemu so wQEMUe can poke keypresses into the VM
# and trigger screenshot captures
if ! t_get_qemu_socket; then
    echo "🚨 Qemu socket is not found."
    exit 1
fi

# Load the keymaps which map keys for different layouts
if ! t_load_keys; then
    echo "🚨 Load keys ${T_KEYMAPS_DIR}/${T_TEST_LANG} failed."
    exit 1
fi

if ! t_load_texts; then
    echo "🚨 Load texts ${T_TEXTS_DIR}/${T_TEST_LANG} failed."
    exit 1
fi

# Finally we launch the actual test case.
if ! t_launch_testcase; then
    echo "🚨 Test case ${TESTCASE} failed."
    exit 1
fi

# If the test case passes, we clean up after ourselves
t_cleanup
t_test_pass "${TESTCASE}"

# Fin
