# Shared helpers for Odyssey Shipwreck quicktest cases
# Sourced by each testcase via:
#   source "$(dirname "${BASH_SOURCE[0]}")/lib-shipwreck"

# Guard against double-start
_SW_SERIAL_PID=""

# Start a background tap on quickemu's serial chardev socket.
# Socket path: ${QUICKEMU_VM_DIR}/${VMNAME}/${VMNAME}-serial.socket
# Streams to ${QT_RESULTS}/serial.log
sw_serial_start() {
    local socket_path="${QUICKEMU_VM_DIR}/${VMNAME}/${VMNAME}-serial.socket"
    local log_file="${QT_RESULTS}/serial.log"

    if [ -n "${_SW_SERIAL_PID}" ] && kill -0 "${_SW_SERIAL_PID}" 2>/dev/null; then
        qt_echo "🔌 Serial tap already running (PID ${_SW_SERIAL_PID})"
        return 0
    fi

    if [ ! -S "${socket_path}" ]; then
        qt_test_fail "Serial socket not found at ${socket_path}"
    fi

    qt_echo "🔌 Starting serial tap on ${socket_path} -> ${log_file}"
    # socat -u UNIX-CONNECT:<path> - reads from socket, writes to stdout
    # Background it and capture PID
    socat -u "UNIX-CONNECT:${socket_path}" - >> "${log_file}" 2>&1 &
    _SW_SERIAL_PID=$!
    qt_echo "🔌 Serial tap PID: ${_SW_SERIAL_PID}"
    return 0
}

# Stop the serial tap
sw_serial_stop() {
    if [ -n "${_SW_SERIAL_PID}" ] && kill -0 "${_SW_SERIAL_PID}" 2>/dev/null; then
        qt_echo "🔌 Stopping serial tap (PID ${_SW_SERIAL_PID})"
        kill "${_SW_SERIAL_PID}" 2>/dev/null
        wait "${_SW_SERIAL_PID}" 2>/dev/null || true
        _SW_SERIAL_PID=""
    else
        qt_echo "🔌 Serial tap not running"
    fi
    return 0
}

# Poll serial log for a literal marker string
# Usage: sw_serial_assert "<marker>" <retries> <interval>
sw_serial_assert() {
    local marker="$1"
    local retries="${2:-30}"
    local interval="${3:-2}"
    local log_file="${QT_RESULTS}/serial.log"

    qt_echo "🔍 Waiting for serial marker: ${marker} (${retries}×${interval}s)"
    for c in $(seq 1 "${retries}"); do
        if [ -f "${log_file}" ] && grep -q -F "${marker}" "${log_file}"; then
            qt_echo "✅ Found marker: ${marker} (attempt ${c})"
            return 0
        fi
        qt_echo "🔁 ${c}/${retries} marker not yet present: ${marker}"
        qt_wait_for_seconds "${interval}"
    done
    qt_test_fail "Serial marker never appeared: ${marker} after ${retries} retries"
}

# Poll serial log for a grep-style regex pattern
# Usage: sw_serial_grep "<pattern>" <retries> <interval>
# Returns 0 if found, 1 if not found after retries (non-fatal; caller decides)
sw_serial_grep() {
    local pattern="$1"
    local retries="${2:-30}"
    local interval="${3:-2}"
    local log_file="${QT_RESULTS}/serial.log"

    qt_echo "🔍 Waiting for serial pattern: ${pattern} (${retries}×${interval}s)"
    for c in $(seq 1 "${retries}"); do
        if [ -f "${log_file}" ] && grep -q -E "${pattern}" "${log_file}"; then
            qt_echo "✅ Found pattern: ${pattern} (attempt ${c})"
            return 0
        fi
        qt_echo "🔁 ${c}/${retries} pattern not yet present: ${pattern}"
        qt_wait_for_seconds "${interval}"
    done
    qt_echo "❌ Serial pattern never appeared: ${pattern} after ${retries} retries"
    return 1
}

# Print a short summary of expected markers found/missing and tail the log
sw_report_serial_summary() {
    local log_file="${QT_RESULTS}/serial.log"
    local markers=(
        "${text_serial_pkg_end}"
        "${text_serial_svc_end}"
        "${text_serial_net_end}"
        "${text_serial_dmesg_end}"
        "${text_serial_oupdate_end}"
    )
    local names=(
        "Package list"
        "Service status"
        "Network status"
        "Dmesg"
        "OUpdate"
    )

    qt_echo "📋 Serial log summary (${log_file}):"
    if [ -f "${log_file}" ]; then
        local i=0
        for m in "${markers[@]}"; do
            if grep -q -F "${m}" "${log_file}"; then
                qt_echo "  ✅ ${names[i]}: FOUND"
            else
                qt_echo "  ❌ ${names[i]}: MISSING"
            fi
            i=$((i+1))
        done
        qt_echo "📄 Last 50 lines of serial log:"
        tail -50 "${log_file}" | while IFS= read -r line; do
            qt_echo "  ${line}"
        done
    else
        qt_echo "  ⚠️  Serial log file does not exist"
    fi
    return 0
}

# Type a shell command into the focused terminal and press Enter
sw_shell() {
    local cmd="$1"
    qt_send_string_return "${cmd}"
    return 0
}

# Type a sudo command with password via sudo -S -p ''
# Usage: sw_shell_sudo <password> <command>
sw_shell_sudo() {
    local password="$1"
    local cmd="$2"
    # sudo -S reads password from stdin, -p '' suppresses prompt
    qt_send_string "sudo -S -p '' "
    qt_send_string "${cmd}"
    qt_send_key_combo "ret"
    qt_wait_for_seconds 1
    qt_send_string_return "${password}"
    return 0
}

# Helper: send a raw QEMU HMP key name (bypasses KEYS lookup entirely)
# qt_send_key resolves arguments through the KEYS associative array which only
# defines: space (" "->spc), enter/return (->ret), escape/esc (->esc), tab (->tab),
# and alphanumerics. It does NOT have: down, up, left, right, f10, end, meta_l,
# shift-tab, backspace, etc. So qt_send_key "space" -> KEYS["space"]="" -> sends
# bare "sendkey " which is a silent no-op. qt_send_key_combo passes its argument
# straight to HMP sendkey with no KEYS lookup — that is the correct path for all
# non-character keys. This helper wraps qt_send_key_combo for clarity.
# Usage: sw_key <qemu_hmp_key_name>
sw_key() {
    local qemu_key="$1"
    case "${qemu_key}" in
        ''|space|return|enter|f1|f2|f3|f4|f5|f6|f7|f8|f9|f11|f12|home)
            qt_test_fail "sw_key: bad QEMU HMP key name «${qemu_key}» — use spc / ret / esc / f10"
            ;;
    esac
    qt_send_key_combo "${qemu_key}"
    return 0
}

# Helper: repeat a key N times
# Usage: sw_tap <count> <qemu_hmp_key_name>
sw_tap() {
    local count="$1"
    local key="$2"
    local i
    for ((i=0; i<count; i++)); do
        sw_key "${key}"
    done
    return 0
}

# Helper: wait for a Calamares step screen by OCR text, screenshot, then send key sequence
# Usage: sw_calamares_step <step_name> <ocr_text_var> <key_sequence...>
# Example: sw_calamares_step "welcome" "text_calamares_welcome_1" "up" "up" "tab" "tab" "tab" "tab" "spc"
# Note: key arguments must be raw QEMU HMP key names (e.g. "spc" not "space", "ret" not "enter").
sw_calamares_step() {
    local step_name="$1"
    local ocr_var="$2"
    shift 2
    local ocr_text="${!ocr_var}"

    qt_wait_for_text "${step_name}" "${ocr_text}" 20 5
    qt_screenshot_ppm "${step_name}"
    qt_wait_for_seconds 1
    for key in "$@"; do
        sw_key "${key}"
    done
    return 0
}

# Edit GRUB kernel command line to add serial console (UEFI path)
# Pattern from ubuntu test_boot_to_live_environment_with_serial_console
sw_grub_edit_serial_console_uefi() {
    local step_name="$1"
    sw_key "e"
    qt_wait_for_seconds 1
    # Move to the linux line (typically 3 downs from default entry)
    sw_tap 3 "down"
    sw_key "end"
    qt_wait_for_seconds 1
    # Screenshot BEFORE backspaces — the 12×backspace count is a guess calibrated
    # for Ubuntu's trailing " splash" (7 chars). If Shipwreck's cmdline differs,
    # this corrupts the linux line and the VM won't boot. The artifact shows why.
    qt_screenshot_ppm "${step_name}_before_backspace"
    # Backspace over trailing "splash" (typically ~12 chars: " splash")
    sw_tap 12 "backspace"
    qt_wait_for_seconds 1
    qt_send_string " console=ttyS0,115200 console=tty0"
    qt_screenshot_ppm "${step_name}"
    sw_key "f10"
    return 0
}

# Wait for one of several GRUB text candidates
sw_wait_for_grub_menu() {
    local step_name="$1"
    local candidates=(
        "${text_console_gnu_grub_1}"
        "${text_console_gnu_grub_2}"
        "${text_console_gnu_grub_3}"
    )
    local retries=24  # ~120s at 5s interval
    local interval=5
    local c found=0

    qt_wait_for_seconds 5
    for c in $(seq 1 "${retries}"); do
        qt_screenshot_ppm "${step_name}"
        for txt in "${candidates[@]}"; do
            if qt_search_screenshot "${step_name}" "${txt}"; then
                qt_echo "✅ GRUB menu detected via: ${txt}"
                found=1
                break 2
            fi
        done
        qt_echo "🔁 ${c}/${retries} GRUB menu not yet visible"
        qt_wait_for_seconds "${interval}"
    done
    if [ ${found} -eq 0 ]; then
        qt_test_fail "GRUB menu not detected after ${retries} retries"
    fi
    return 0
}

