# --- Reboot into installed system (UEFI) ---
# Oculix (shipwreck-install.py:548-552) does `down`×3 + `enter` at the installed GRUB
# but that is BIOS-only; on UEFI the default entry boots by itself. We wait for the
# installed GRUB to appear and let the default entry boot without key presses.
sw_reboot_to_installed() {
    local candidates=(
        "${text_grub_installed_1}"
        "${text_grub_installed_2}"
        "${text_grub_installed_3}"
    )
    local retries=24
    local interval=5
    local c found=0

    for c in $(seq 1 "${retries}"); do
        qt_screenshot_ppm "grub_installed"
        for txt in "${candidates[@]}"; do
            if qt_search_screenshot "grub_installed" "${txt}"; then
                qt_echo "✅ Installed-system GRUB detected via: ${txt}"
                found=1
                break 2
            fi
        done
        qt_echo "🔁 ${c}/${retries} Installed GRUB not yet visible"
        qt_wait_for_seconds "${interval}"
    done
    if [ ${found} -eq 0 ]; then
        qt_test_fail "Installed-system GRUB not detected after ${retries} retries — booted back to live ISO?"
    fi
    qt_wait_for_seconds 5
}

# --- LUKS unlock (twice: root + swap) for FDE ---
sw_luks_unlock_twice() {
    # First unlock (root partition)
    qt_wait_for_text "luks_unlock_1" "${text_luks_unlock_1}" 30 5
    qt_screenshot_ppm "luks_unlock_1"
    qt_send_string_return "${test_passphrase}"
    qt_wait_for_seconds 3

    # Second unlock (swap) — tolerant: warn if not seen, don't hard fail
    local c found=0
    for c in $(seq 1 10); do
        qt_screenshot_ppm "luks_unlock_2"
        if qt_search_screenshot "luks_unlock_2" "${text_luks_unlock_1}"; then
            qt_echo "✅ Second LUKS unlock prompt detected"
            qt_send_string_return "${test_passphrase}"
            found=1
            break
        fi
        qt_echo "🔁 ${c}/10 waiting for second LUKS prompt"
        qt_wait_for_seconds 3
    done
    if [ ${found} -eq 0 ]; then
        qt_echo "⚠️  Second LUKS unlock prompt not detected (may not exist on this config)"
    fi
}

