sw_post_install_inventories() {
    qt_send_key_combo "ctrl-alt-t"
    qt_wait_for_text "post_terminal" "${text_shell_prompt}" 10 2
    qt_screenshot_ppm "post_terminal"
    sw_inject_inventories_installed "${test_password}"
    sw_assert_all_serial_markers_installed
    qt_send_key_combo "ctrl-shift-q"
    qt_screenshot_ppm "post_terminal_closed"
}