# ============================================================
# Shared installer runner — called by both install testcases
# Usage: sw_run_installer <encrypt:true|false>
# Encapsulates the full Calamares flow; individual step functions
# remain in the testcase files so failures name the exact step.
# ============================================================
sw_run_installer() {
    local encrypt="$1"  # "true" or "false"

    # Boot to live desktop and start serial tap
    sw_boot_to_live_desktop
    sw_launch_calamares
    sw_calamares_welcome
    sw_calamares_time_localization
    sw_calamares_keyboard
    sw_calamares_de_selection

    if [ "${encrypt}" = "true" ]; then
        sw_calamares_partitioning_enc_uefi
    else
        sw_calamares_partitioning_noenc_uefi
    fi

    sw_calamares_users
    sw_calamares_summary
    sw_calamares_install
    sw_calamares_finished_restart
    sw_reboot_to_installed

    if [ "${encrypt}" = "true" ]; then
        sw_luks_unlock_twice
    fi

    sw_sddm_login_plasma_x11
    sw_post_install_inventories
    sw_serial_stop
    sw_report_serial_summary
    qt_poweroff_vm
}

# --- Boot to live desktop (shared) ---
sw_boot_to_live_desktop() {
    sw_serial_start
    sw_wait_for_grub_menu "grub_menu"
    sw_grub_edit_serial_console_uefi "grub_edit_serial"
    sw_wait_for_live_desktop "live_desktop"
}

# --- Launch Calamares from application launcher ---
sw_launch_calamares() {
    qt_send_key_combo "meta_l"
    qt_wait_for_seconds 1
    qt_send_string "install"
    qt_wait_for_seconds 1
    qt_send_key_combo "ret"
    qt_wait_for_seconds 3
    qt_screenshot_ppm "calamares_launch"
    if qt_search_screenshot "calamares_launch" "close"; then
        qt_send_key_combo "esc"
        qt_wait_for_seconds 1
    fi
}

