# Inject inventory commands to serial console
# In live session (no root password), run without sudo
# In installed session, run with sudo using user password
sw_inject_inventories_live() {
    # Long typed commands (~1000 HMP round-trips); raise delay to avoid dropped chars
    # when QEMU hasn't re-armed its monitor listener between socat connects.
    export QEMU_INSERT_DELAY="${QEMU_INSERT_DELAY:-0.35}"
    qt_echo "📦 Injecting live-session inventories to serial console"
    sw_shell "echo '${text_serial_pkg_start}' > /dev/ttyS0; olist > /dev/ttyS0 2>&1; echo '${text_serial_pkg_end}' > /dev/ttyS0"
    sw_shell "echo '${text_serial_svc_start}' > /dev/ttyS0; sv status /var/service/* > /dev/ttyS0 2>&1; echo '${text_serial_svc_end}' > /dev/ttyS0"
    sw_shell "echo '${text_serial_net_start}' > /dev/ttyS0; ip a > /dev/ttyS0 2>&1; curl -s http://detectportal.firefox.com/canonical.html > /dev/ttyS0 2>&1; echo '${text_serial_net_end}' > /dev/ttyS0"
    sw_shell "echo '${text_serial_dmesg_start}' > /dev/ttyS0; dmesg > /dev/ttyS0 2>&1; echo '${text_serial_dmesg_end}' > /dev/ttyS0"
    return 0
}

sw_inject_inventories_installed() {
    local user_password="$1"
    # Long typed commands (~1000 HMP round-trips); raise delay to avoid dropped chars
    # when QEMU hasn't re-armed its monitor listener between socat connects.
    export QEMU_INSERT_DELAY="${QEMU_INSERT_DELAY:-0.35}"
    qt_echo "📦 Injecting installed-system inventories to serial console (with sudo)"
    sw_shell_sudo "${user_password}" "echo '${text_serial_pkg_start}' > /dev/ttyS0; olist > /dev/ttyS0 2>&1; echo '${text_serial_pkg_end}' > /dev/ttyS0"
    sw_shell_sudo "${user_password}" "echo '${text_serial_svc_start}' > /dev/ttyS0; sv status /var/service/* > /dev/ttyS0 2>&1; echo '${text_serial_svc_end}' > /dev/ttyS0"
    sw_shell_sudo "${user_password}" "echo '${text_serial_net_start}' > /dev/ttyS0; ip a > /dev/ttyS0 2>&1; curl -s http://detectportal.firefox.com/canonical.html > /dev/ttyS0 2>&1; echo '${text_serial_net_end}' > /dev/ttyS0"
    sw_shell_sudo "${user_password}" "echo '${text_serial_dmesg_start}' > /dev/ttyS0; dmesg > /dev/ttyS0 2>&1; echo '${text_serial_dmesg_end}' > /dev/ttyS0"
    sw_shell_sudo "${user_password}" "echo '${text_serial_oupdate_start}' > /dev/ttyS0; oupdate > /dev/ttyS0 2>&1; echo '${text_serial_oupdate_end}' > /dev/ttyS0"
    # Re-run package list and service status after oupdate
    sw_shell_sudo "${user_password}" "echo '${text_serial_pkg_start}' > /dev/ttyS0; olist > /dev/ttyS0 2>&1; echo '${text_serial_pkg_end}' > /dev/ttyS0"
    sw_shell_sudo "${user_password}" "echo '${text_serial_svc_start}' > /dev/ttyS0; sv status /var/service/* > /dev/ttyS0 2>&1; echo '${text_serial_svc_end}' > /dev/ttyS0"
    return 0
}

