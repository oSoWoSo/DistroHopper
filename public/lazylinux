editions_() {
	web_pipe "${RSS}" \
		| grep -oP 'lazylinux-live-x86_64-[0-9]{8}-\K[^/]+(?=\.iso)' \
		| sort -u
}

get_() {
	local RSS_ISO
	RSS_ISO=$(web_pipe "${RSS}" \
		| grep -oP "iso/[^<]*lazylinux-live-x86_64-[0-9]{8}-${EDITION}\\.iso" \
		| head -1)
	[ -n "${RSS_ISO}" ] || return 1

	local ISO="${RSS_ISO##*/}"
	local URL="https://sourceforge.net/projects/lazylinux/files/${RSS_ISO%/*}"
	local HASH
	HASH=$(web_pipe "${URL}/sha256sum.txt" | grep -F "${ISO}" | awk 'NR==1 {print $1}')
	echo "${URL}/${ISO} ${HASH}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
