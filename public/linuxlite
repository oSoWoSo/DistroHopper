get_() {
	local HASH=""
	local ISO="linux-lite-${RELEASE}-64bit.iso"
	local URL="https://sourceforge.net/projects/linux-lite/files/${RELEASE}"
	HASH=$(web_pipe "${URL}/${ISO}.sha256" | cut -d' ' -f1)
	echo "${URL}/${ISO} ${HASH}"
}
