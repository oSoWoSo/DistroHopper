kde
xfce"
QEMU_ARCH="amd64"

releases_() {
	echo latest
}

editions_() {
	echo kde gnome xfce
}

get_() {
	local FILE
	FILE=$(web_pipe "${RSS}" \
		| grep -oE '/noid-live-weekly-[0-9]+/noid-live-x86_64-[0-9]+-[^<"]+\.iso' \
		| grep -E -- "-${EDITION}(-runit|-dinit)?\.iso$" | head -1)
	[ -n "${FILE}" ] || return 1
	echo "https://sourceforge.net/projects/noid-linux/files${FILE}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
