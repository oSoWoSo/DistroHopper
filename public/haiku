QEMU_ARCH="amd64"

releases_() {
	echo r1beta5 r1beta4 r1beta3
}

editions_() {
	echo x86_64 x86_gcc2h
}

get_() {
	local ISO="haiku-${RELEASE}-${EDITION}-anyboot.iso"
	local URL="http://mirror.rit.edu/haiku/${RELEASE}"
	HASH=$(web_pipe "${URL}/${ISO}.sha256" | grep "${ISO}" | cut -d' ' -f4)
	echo "${URL}/${ISO} ${HASH}"
}

config_() {
	echo "boot=\"legacy\"" >> "${CONF_FILE}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
