# Template file for 'loc-os'
OSNAME="loc-os"
PRETTY="Loc-OS Linux"
LOGO=""
ICON="loc-os.svg"
ICON_ONLINE=""
CATEGORY="Lightweight"
BASEDOF="Debian"
DESCRIPTION="Distribution of GNU/Linux focused on low resource consumption."
HOMEPAGE="https://loc-os.com"
CREDENTIALS="-"
GPG=""
RSS=""
DW=""
MAGNET=""
MAGNET_PREFERRED=""
TORRENT=""
CHAT=""

RELEASES="latest"
EDITIONS="kde lxde xfce"
EDITIONS_LIST="kde
lxde
xfce"
QEMU_ARCH="amd64"

releases_() {
	echo latest
}

editions_() {
	echo lxde xfce kde
}

get_() {
	local HASH=""
	local REL=$(echo "${EDITION}" | tr '[:lower:]' '[:upper:]')
	URL="https://sourceforge.net/projects/loc-os/files"
	REST_URL=$(web_pipe "https://sourceforge.net/projects/loc-os/rss?path=/" | grep 'title><!\[CDATA' | cut -d'[' -f3 | cut -d']' -f1 | grep '64\.iso' | grep "${REL}" | head -1)
	REST="Loc-OS%2023"
	URL="${URL}/${REST}"
	ISO=$(echo "${REST_URL}" | cut -d'/' -f3)
	echo "${URL}/${ISO}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
