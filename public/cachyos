get_() {
	local HASH=""
	local URL=""
	URL="$(web_pipe "https://cachyos.org/download/" | tr '&' '\n' | grep "ISO/${EDITION}" | grep -v 'iso.sha' | grep -v 'iso.sig' | cut -d';' -f2)"
	HASH=$(web_pipe "${URL}.sha256" | cut -d' ' -f1)
	echo "${URL} ${HASH}"
}

config_() {
	echo "disk_size=\"64G\"" >> "${CONF_FILE}"
}
