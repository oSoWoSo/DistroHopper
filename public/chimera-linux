releases_() {
	echo latest
}

editions_() {
	echo base gnome
}

get_() {
	local DATE=""
	local HASH=""
	local URL="https://repo.chimera-linux.org/live/${RELEASE}"
	DATE=$(web_pipe "${URL}/sha256sums.txt" | head -n1 | cut -d'-' -f5)
	local ISO="chimera-linux-x86_64-LIVE-${DATE}-${EDITION}.iso"
	HASH=$(web_pipe "${URL}/sha256sums.txt" | grep 'x86_64-LIVE' | grep "${EDITION}" | cut -d' ' -f1)
	echo "${URL}/${ISO} ${HASH}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
