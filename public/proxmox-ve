# Template file for 'proxmox-ve'
OSNAME="proxmox-ve"
PRETTY="Proxmox VE"
LOGO=""
ICON="proxmox.svg"
ICON_ONLINE="https://distrowatch.com/images/yvzhuwbpy/proxmox.png"
CATEGORY="advanced"
BASEDOF="Debian"
DESCRIPTION="Proxmox Virtual Environment is a complete, open-source server management platform for enterprise virtualization"
HOMEPAGE="https://proxmox.com/en/proxmox-virtual-environment"
CREDENTIALS="-"
GPG=""
RSS=""
DW=""
MAGNET=""
CHAT=""

RELEASES="9.2-1 9.1-1 9.0-1 8.4-1 7.4-1 6.4-1 5.4-1"
QEMU_ARCH="amd64"

releases_() {
	#shellcheck disable=SC2046,SC2005
	web_pipe https://enterprise.proxmox.com/iso/ | grep proxmox-ve | grep -E -o '[0-9]+\.[0-9]+-[0-9]\.iso' | uniq | sort -ru | cut -d'.' -f 1-2
}

get_() {
	local HASH=""
	local ISO=""
	local URL=""
	ISO="proxmox-ve_${RELEASE}.iso"
	URL="https://enterprise.proxmox.com/iso"
	HASH=$(web_pipe "${URL}/SHA256SUMS" | grep "${ISO}" | cut -d' ' -f1)
	echo "${URL}/${ISO} ${HASH}"
}

config_() {
	echo "disk_size=\"20G\"" >> "${CONF_FILE}"
	echo "ram=\"4G\"" >> "${CONF_FILE}"
}
