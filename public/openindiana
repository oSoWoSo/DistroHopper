releases_() {
	local dir
	for dir in $(web_pipe "https://dlc.openindiana.org/isos/hipster/" | grep 'href="./2' | cut -d'/' -f 2 | sort -r); do
		if web_check "https://dlc.openindiana.org/isos/hipster/${dir}/OI-hipster-gui-${dir}.iso" >/dev/null 2>&1; then
			echo "${dir}"
		fi
	done | head -n 5 | paste -sd ' '
}

editions_() {
	echo gui text minimal
}

get_() {
	local HASH=""
	local ISO=""
	local URL=""
	URL="https://dlc.openindiana.org/isos/hipster/${RELEASE}"
	ISO="OI-hipster-${EDITION}-${RELEASE}.iso"
	HASH=$(web_pipe "${URL}/${ISO}.sha256" |cut -d' ' -f1)
	echo "${URL}/${ISO} ${HASH}"
}

config_() {
	echo "boot=\"legacy\"" >> "${CONF_FILE}"
	echo "disk_size=\"32G\"" >> "${CONF_FILE}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
