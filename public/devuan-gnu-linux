_release_editions_() {
	case "${1:-}" in
		"amd64|daedalus")	 echo "desktop desktop-live netinstall server" ;;
		"amd64|excalibur")	 echo "desktop desktop-live netinstall server" ;;
		"amd64|chimaera")	 echo "desktop desktop-live netinstall server" ;;
		"amd64|jessie")	 echo "desktop-live" ;;
		*) return 1 ;;
	esac
}

releases_() {
	local INDEX=""
	local STABLE=""
	local RELEASES=""
	INDEX=$(web_pipe "https://files.devuan.org/")
	STABLE=$(printf '%s\n' "${INDEX}" \
		| grep -oE 'LATEST_STABLE_IS_[A-Z]+' \
		| sed 's/^LATEST_STABLE_IS_//' \
		| tr '[:upper:]' '[:lower:]')
	RELEASES=$(printf '%s\n' "${INDEX}" \
		| grep -oE 'devuan_[a-z]+/' \
		| sed -E 's#^devuan_([^/]+)/$#\1#')
	{
		printf '%s\n' "${STABLE}"
		printf '%s\n' "${RELEASES}"
	} | awk 'NF && !seen[$0]++'
}

editions_() {
	local ARCH="${ARCH:-amd64}"
	local SELECTED_RELEASE="${RELEASE:-$(releases_ | awk 'NR == 1 {print; exit}')}"
	local BASE_URL="https://files.devuan.org/devuan_${SELECTED_RELEASE}"
	{
		web_pipe "${BASE_URL}/installer-iso/" \
			| grep -oE "devuan_${SELECTED_RELEASE}_[0-9]+\.[0-9]+\.[0-9]+_${ARCH}_(desktop|netinstall|server)\.iso" \
			| sed -E "s/^.*_${ARCH}_([^.]*)\.iso$/\1/"
		web_pipe "${BASE_URL}/desktop-live/" \
			| grep -oE "devuan_${SELECTED_RELEASE}_[0-9]+\.[0-9]+\.[0-9]+_${ARCH}_desktop-live\.iso" \
			| sed -E "s/^.*_${ARCH}_([^.]*)\.iso$/\1/"
	} | sort -u
}

arch_() {
	echo amd64
}

get_() {
	local ARCH="${ARCH:-amd64}"
	local BASE_URL="https://files.devuan.org/devuan_${RELEASE}"
	local ISO_DIR="installer-iso"
	case "${EDITION}" in
		desktop-live) ISO_DIR="desktop-live";;
		desktop|netinstall|server) ISO_DIR="installer-iso";;
		*) return 1;;
	esac
	local ISO=""
	ISO=$(web_pipe "${BASE_URL}/${ISO_DIR}/" \
		| grep -oE "devuan_${RELEASE}_[0-9]+\.[0-9]+\.[0-9]+_${ARCH}_${EDITION}\.iso" \
		| sort -V \
		| tail -n 1)
	[ -n "${ISO}" ] || return 1
	local HASH=""
	if [ "${ISO_DIR}" == "desktop-live" ]; then
		HASH=$(web_pipe "${BASE_URL}/${ISO_DIR}/${ISO}.sha256" | grep -oE '^[[:xdigit:]]{64}' | head -n 1)
	else
		HASH=$(web_pipe "${BASE_URL}/installer-iso/SHA256SUMS.txt" \
			| awk -v iso="${ISO}" '$2 == iso {print $1; exit}')
	fi
	echo "${BASE_URL}/${ISO_DIR}/${ISO} ${HASH}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
