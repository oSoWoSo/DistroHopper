get_() {
	local HASH=""
	local ISO=""
	local URL="https://download.bazzite.gg"
	case ${EDITION} in
		gnome) ISO="bazzite-gnome-stable-amd64.iso";;
		kde)  ISO="bazzite-stable-amd64.iso";;
	esac
	HASH=$(web_pipe "${URL}/${ISO}-CHECKSUM" | cut -d' ' -f1)
	echo "${URL}/${ISO} ${HASH}"
}
