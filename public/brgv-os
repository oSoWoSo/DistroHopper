releases_() {
	echo latest
}

editions_() {
	echo en_US ro_RO
}

get_() {
	local URL="https://sourceforge.net/projects/brgv-os/files/brgv-os/${EDITION}"
	local ISOname
	ISOname=$(web_pipe "https://sourceforge.net/projects/brgv-os/rss?path=/brgv-os/${EDITION}" \
		| grep 'title><!\[CDATA' | cut -d'[' -f3 | cut -d']' -f1 \
		| grep "/${EDITION}/" | grep '\.iso' \
		| cut -d'/' -f4 | sed 's/\.iso$//' | head -1)
	local ISO="${ISOname}.iso"
	local HASH
	HASH=$(web_pipe "${URL}/${ISOname}.sha256")
	echo "${URL}/${ISO} ${HASH}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
