releases_() {
	# shellcheck disable=SC2046
	echo $(web_pipe "https://ftp.fau.de/pclinuxos/iso" | grep -oP 'pclinuxos64-\K[^\-]+-\K[0-9]+\.[0-9]+' | sort -ur | head -n 1)
}

editions_() {
	echo kde kde-darkstar mate xfce
}

get_() {
	local URL="https://ftp.fau.de/pclinuxos/iso"
	local IMAGE_EDITION="${EDITION}"
	case "${EDITION}" in
		mate) IMAGE_EDITION="MATE";;
		xfce) IMAGE_EDITION="XFCE";;
	esac
	local ISO="pclinuxos64-${IMAGE_EDITION}-${RELEASE}.iso"
	local HASH=""
	HASH=$(web_pipe "${URL}/${ISO}.md5sum" | awk -v iso="${ISO}" '$2 == iso && length($1) == 32 {print $1; exit}')
	echo "${URL}/${ISO} ${HASH}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
