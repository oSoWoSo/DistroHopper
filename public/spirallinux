get_() {
	local HASH=""
	local ISO="SpiralLinux_${EDITION}_12.231005_x86-64.iso"
	local URL="https://sourceforge.net/projects/spirallinux/files/12.231005"
	HASH=$(web_pipe 'https://sourceforge.net/projects/spirallinux/rss?path=/' | grep "${ISO}" | grep 'md5' | cut -d'<' -f3 | cut -d'>' -f2)
	echo "${URL}/${ISO}" "${HASH}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
