# Template file for 'zorin-os'
OSNAME="zorin-os"
PRETTY="Zorin OS"
LOGO=" "
ICON="zorin-os.svg"
ICON_ONLINE=""
CATEGORY="Beginner"
BASEDOF="Ubuntu"
DESCRIPTION="Alternative to Windows and macOS designed to make your computer faster, more powerful, secure, and privacy-respecting"
HOMEPAGE="https://zorin.com/os"
CREDENTIALS="-"
GPG=""
RSS=""
DW=""
MAGNET=""
MAGNET_PREFERRED=""
TORRENT=""
CHAT=""

RELEASES="18 17 16"
EDITIONS="core64 education64 lite64"
EDITIONS_LIST="core64
education64
lite64"
QEMU_ARCH="amd64"

_release_editions_() {
	case "${1:-}" in
		"amd64|16")	 echo "core64 education64 lite64" ;;
		"amd64|17")	 echo "core64 education64 lite64" ;;
		"amd64|18")	 echo "core64 education64" ;;
		*) return 1 ;;
	esac
}

releases_() {
	echo 18 17 16
}

editions_() {
	if [ -z "${RELEASE}" ] || [ "${RELEASE}" != "18" ]; then
		echo core64 lite64 education64
	else
		echo core64 education64
	fi
}

get_() {
	local HASH=""
	local ISO=""
	local URL="https://plug-mirror.rcac.purdue.edu/zorin-iso/${RELEASE}"
	local EDITION_NAME=""
	case ${EDITION} in
		core64)      EDITION_NAME="Core-64-bit";;
		lite64)      EDITION_NAME="Lite-64-bit";;
		education64) EDITION_NAME="Education-64-bit";;
	esac
	ISO=$(web_pipe "${URL}/" | grep -o "Zorin-OS-[0-9.]*-${EDITION_NAME}[^\"]*\.iso" | grep -v Beta | sort -Vr | head -n 1)
	if [ -z "${ISO}" ]; then
		echo ""
		return
	fi
	HASH=$(web_pipe "${URL}/SHA256SUMS.txt" | grep "${ISO}" | cut -d' ' -f1)
	echo "${URL}/${ISO} ${HASH}"
}

config_() {
	case ${EDITION} in
		education64|lite64) echo "disk_size=\"32G\"" >> "${CONF_FILE}"
	esac
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
