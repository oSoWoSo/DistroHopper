		| tr -d '/' \
		| sort -Vr
}

editions_() {
	echo standard
}

arch_() {
	echo amd64 arm64
}

get_() {
	local UPSTREAM_ARCH="x86_64"
	[ "${ARCH:-amd64}" == "arm64" ] && UPSTREAM_ARCH="aarch64"
	local URL="https://dl-cdn.alpinelinux.org/alpine/${RELEASE}/releases/${UPSTREAM_ARCH}"
	local ISO=""
	ISO=$(web_pipe "${URL}/" \
		| grep -oE "alpine-standard-[0-9]+\.[0-9]+\.[0-9]+-${UPSTREAM_ARCH}\.iso" \
		| sort -V \
		| tail -n 1)
	[ -n "${ISO}" ] || return 1
	local HASH=""
	HASH=$(web_pipe "${URL}/${ISO}.sha256" | grep -oE '^[[:xdigit:]]{64}' | head -n 1)
	echo "${URL}/${ISO} ${HASH}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
