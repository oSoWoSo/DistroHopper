# Template file for 'alpine'
OSNAME="alpine"
PRETTY="Alpine Linux"
ICON="alpine.svg"
CATEGORY="lightweight"
BASEDOF="-"
DESCRIPTION="Security-oriented, lightweight Linux distribution based on musl libc and busybox"
HOMEPAGE="https://alpinelinux.org/"
CREDENTIALS="root:(no password)"


RELEASES="v3.23 v3.22 v3.21 v3.20 v3.19 v3.18 v3.17 v3.16 v3.15 v3.14"

ARCHITECTURES="x86_64 x86 aarch64 armhf armv7 ppc64le loongarch64 riscv64 s390x"


function arch_() {
    echo "x86_64 x86 aarch64 armhf armv7 ppc64le loongarch64 riscv64 s390x"
}

function get_() {
    local HASH=""
    local ISO=""
    local ARCH_KW="${ARCH:-x86_64}"

    case "${ARCH}" in
        x86) ARCH_KW="x86";;
        aarch64) ARCH_KW="aarch64";;
        armhf|armv7) ARCH_KW="armv7";;
        ppc64le) ARCH_KW="ppc64le";;
        loongarch64) ARCH_KW="loongarch64";;
        riscv64) ARCH_KW="riscv64";;
        s390x) ARCH_KW="s390x";;
        *) ARCH_KW="x86_64";;
    esac

    local URL="https://dl-cdn.alpinelinux.org/alpine/${RELEASE}/releases/${ARCH_KW}"
    local VERSION=""
    VERSION=$(web_pipe "${URL}/latest-releases.yaml" | awk '/"Xen"/{found=0} {if(found) print} /"Virtual"/{found=1}' | grep 'version:' | awk '{print $2}')
    ISO="alpine-virt-${VERSION}-${ARCH_KW}.iso"
    HASH=$(web_pipe "${URL}/latest-releases.yaml" | awk '/"Xen"/{found=0} {if(found) print} /"Virtual"/{found=1}' | grep 'sha256:' | awk '{print $2}')
    echo "${URL}/${ISO} ${HASH}"
}

