# Template file for 'fuss'
OSNAME="fuss"
PRETTY="FUSS Linux"
LOGO=""
ICON="fuss.svg"
ICON_ONLINE=""
CATEGORY="Education"
BASEDOF="Debian"
DESCRIPTION="Debian-based GNU/Linux distribution for schools in South Tyrol, with live and educational editions"
HOMEPAGE="https://fuss.bz.it"
CREDENTIALS="user:live"
GPG=""
RSS=""
DW=""
MAGNET=""
MAGNET_PREFERRED=""
TORRENT=""
CHAT=""

RELEASES="13"
EDITIONS="base education"
EDITIONS_LIST="base
education"
QEMU_ARCH="amd64"

releases_() {
	echo 13
}

editions_() {
	echo base education
}

arch_() {
	echo amd64
}

get_() {
	local URL="https://iso.fuss.bz.it/fuss${RELEASE}/client"
	local ISO=""
	local HASH=""
	ISO=$(web_pipe "${URL}/" | grep -oE "fuss-${RELEASE}\\.[0-9]+(\\.[0-9]+)*-amd64-live-${EDITION}\\.iso" | sort -V | tail -n 1)
	[ -n "${ISO}" ] || return 0
	HASH=$(web_pipe "${URL}/sha256sums.txt" | awk -v iso="${ISO}" '$2 == iso {print $1; exit}')
	echo "${URL}/${ISO} ${HASH}"
}

config_() {
	echo 'disk_size="32G"' >> "${CONF_FILE}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
editions_() {
	# Editions parsed at generation time — no network access needed.
	local _scoped=""
	if [ -n "${RELEASE:-}" ] && declare -F _release_editions_ >/dev/null; then
		_scoped=$(_release_editions_ "${ARCH:-}|${RELEASE}")
	fi
	if [ -n "${_scoped}" ]; then
		echo "${_scoped}"
		return 0
	fi
	local _per_arch="EDITIONS_${ARCH:-}"
	if [ -n "${!_per_arch:-}" ]; then
		echo "${!_per_arch}"
		return 0
	fi
	echo "${EDITIONS:-}"
}
