# Template file for 'slitaz'
OSNAME="slitaz"
PRETTY="SliTaz"
LOGO=""
ICON="slitaz.svg"
ICON_ONLINE=""
CATEGORY="Lightweight"
BASEDOF="-"
DESCRIPTION="Simple, fast and low resource Linux OS for servers & desktops"
HOMEPAGE="https://www.slitaz.org"
CREDENTIALS="-"
GPG=""
RSS=""
DW=""
MAGNET=""
MAGNET_PREFERRED=""
TORRENT=""
CHAT=""

RELEASES="rolling-preinit rolling-loram rolling-core64 rolling-core-5in1 rolling-core rolling"
QEMU_ARCH="amd64"

releases_() {
	# The mirror serves a plain directory index. The rolling images are named
	# slitaz-rolling-<variant>.iso; the default one has no variant suffix and
	# is called "rolling".
	#shellcheck disable=SC2046,SC2005
	echo $(web_pipe "https://mirror.slitaz.org/iso/rolling/" \
		| grep -oE 'slitaz-rolling(-[a-z0-9-]+)?\.iso' \
		| sed 's|\.iso$||; s|^slitaz-rolling||' \
		| sed 's|^$|rolling|; s|^-|rolling-|' \
		| sort -u)
}

get_() {
	local HASH=""
	local VARIANT="${RELEASE#rolling}"
	local VARIANT="${VARIANT#-}"
	local ISO="slitaz-rolling"
	[ -n "${VARIANT}" ] && ISO="${ISO}-${VARIANT}"
	local URL="https://mirror.slitaz.org/iso/rolling"
	HASH=$(web_pipe "${URL}/${ISO}.md5" | cut -d' ' -f1)
	echo "${URL}/${ISO}.iso ${HASH}"
}

config_() {
	echo "boot=\"legacy\"" >> "${CONF_FILE}"
	echo "disk_size=\"4G\"" >> "${CONF_FILE}"
	echo "ram=\"512M\"" >> "${CONF_FILE}"
}

releases_() {
	# Releases parsed at generation time — no network access needed.
	echo "${RELEASES}"
}
