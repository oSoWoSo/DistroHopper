function write_output() {
	. "${TEMPLATES_DIR}/${OS}"
	# Load the list of RELEASES (format: "OS ARCH RELEASE EDITION")
	RELEASES=$(cut -d: -f1 < "${PUBLIC_DIR}/tmp_${OS}" | cut -d' ' -f3 | sort -ur | paste -sd ' ')
	# Check if 'edition' function exists and load it if present
	if grep -q 'GUEST' "${TEMPLATES_DIR}/${OS}"; then
		GUEST=$(printf 'GUEST="%s"\n' "$(grep 'GUEST' < "${TEMPLATES_DIR}/${OS}" | cut -d'"' -f2)")
	else
		GUEST=$(echo -e "\n")
	fi
	if grep -q 'IMAGE_TYPE' "${TEMPLATES_DIR}/${OS}"; then
		IMAGE_TYPE=$(printf 'IMAGE_TYPE="%s"\n' "$(grep 'IMAGE_TYPE' < "${TEMPLATES_DIR}/${OS}" | cut -d'"' -f2)")
	else
		IMAGE_TYPE=$(echo -e "\n")
	fi
	if grep -q 'function edition' "${TEMPLATES_DIR}/${OS}"; then
		. "${TEMPLATES_DIR}/${OS}"
		EDITIONS=$(printf 'EDITIONS="%s"\n' "$(cut -d: -f1 < "${PUBLIC_DIR}/tmp_${OS}" | cut -d' ' -f4 | sort -ur | paste -sd ' ')")
		if [ -z "$RELEASES" ] || [ -z "$EDITIONS" ]; then
			exit 1
		fi
	else
		EDITIONS=$(echo -e "\n")
		if [ -z "$RELEASES" ]; then
			exit 1
		fi
	fi

	# Load ARCHITECTURES (unique architectures from tmp file)
	if grep -q 'function arch_' "${TEMPLATES_DIR}/${OS}"; then
		. "${TEMPLATES_DIR}/${OS}"
		ARCHITECTURES=$(printf 'ARCHITECTURES="%s"\n' "$(arch_)")
		# Include arch_() function in template
		ARCH_FUNC=$(printf '\nfunction arch_() {\n    echo "%s"\n}\n' "$(arch_)")
	else
		ARCHITECTURES=$(printf 'ARCHITECTURES="%s"\n' "$(cut -d: -f1 < "${PUBLIC_DIR}/tmp_${OS}" | cut -d' ' -f2 | sort -u | paste -sd ' ')")
		ARCH_FUNC=""
	fi

	echo
	REST=$(sed -n '/^function get_()/,$p' "${TEMPLATES_DIR}/${OS}")
	# Create and save the template with all collected information
	printf '# Template file for '\''%s'\''
OSNAME="%s"
PRETTY="%s"
ICON="%s"
CATEGORY="%s"
BASEDOF="%s"
DESCRIPTION="%s"
HOMEPAGE="%s"
CREDENTIALS="%s"
%s
%s
RELEASES="%s"
%s
%s

%s

%s

' "$OS" "$OSNAME" "$PRETTY" "$ICON" "$CATEGORY" "$BASEDOF" "$DESCRIPTION" "$HOMEPAGE" "$CREDENTIALS" "$GUEST" "$IMAGE_TYPE" "$RELEASES" "$EDITIONS" "$ARCHITECTURES" "$ARCH_FUNC" "$REST" | tee -a "${PUBLIC_DIR}/${OS}"
	# Append content from tmp_${OS} to TODO/all and remove the temporary file
	cat "${PUBLIC_DIR}/tmp_${OS}" >> TODO/all
	#rm "${PUBLIC_DIR}/tmp_${OS}"
	echo
}

function is_arch_supported() {
	local OS="${1}"
	local CHECK_ARCH="${2}"
	local SUPPORTED=""

	if [[ $(type -t "arch_") == function ]]; then
		SUPPORTED=$(arch_)
	else
		SUPPORTED="amd64"
	fi

	[[ " ${SUPPORTED} " == *" ${CHECK_ARCH} "* ]]
}

function test_result() {
	local OS="${1}"
	local ARCH="${2:-amd64}"
	local RELEASE="${3}"
	local EDITION="${4:-}"
	local URL="${5:-}"
	local RESULT="${6:-}"

	if [ -n "${EDITION}" ]; then
		OS="${OS} ${ARCH} ${RELEASE} ${EDITION}"
	else
		OS="${OS} ${ARCH} ${RELEASE}"
	fi

	if [ -n "${RESULT}" ]; then
		OS=$(printf "%-40s" "${OS}")
		echo -e "${OS} ${URL}"
	else
		OS=$(printf "%-41s" "${OS}:")
		echo -e "${OS} ${URL}"
	fi
}

