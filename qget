function check_vm_folder_name() {
	local name="${1}"
	# Underscores are part of real release names (e.g. "45_Beta"), so they
	# have to be allowed in the folder name.
	if [[ "$name" =~ [^a-zA-Z0-9._+\-] ]]; then
		echo $"ERROR! VM folder name '${name}' contains invalid characters." >&2
		exit 1
	fi
	if [ -d "$name" ]; then
		echo $"WARNING! VM folder '${name}' already exists, files may be overwritten." >&2
	fi
	local avail_kb
	avail_kb=$(df -k . 2>/dev/null | awk 'NR==2{print $4}')
	if [[ -n "$avail_kb" && "$avail_kb" -lt 5242880 ]]; then
		echo $"WARNING! Less than 5 GB of free disk space available." >&2
	fi
}

function check_download_url() {
	local url="${1}"
	local result http_code content_type
	result=$(curl --silent --head --location --max-time 15 --connect-timeout 5 \
		--write-out "%{http_code} %{content_type}" --output /dev/null "${url}" 2>/dev/null)
	http_code="${result%% *}"
	content_type="${result#* }"
	if [[ "$http_code" != "200" ]]; then
		echo $"WARNING: URL returned HTTP ${http_code}" >&2
		return 1
	fi
	if echo "$content_type" | grep -qi "text/html"; then
		echo $"WARNING: URL points to an HTML page, not a file" >&2
		return 1
	fi
	return 0
}

function create_vm() {
	# shellcheck disable=SC2206
	local URL_HASH=(${1// / })
	local URL="${URL_HASH[0]}"
	local HASH="${URL_HASH[1]}"
	local TORRENT_URL=""
	# GitLab artifact URLs include a query string, which is not a filename.
	local IMAGE_URL="${URL%%[?#]*}"
	local ISO="${IMAGE_URL##*/}"
	if [[ "${URL}" == *.torrent ]]; then
		TORRENT_URL="${URL}"
		URL="${URL%.torrent}"
		ISO="${ISO%.torrent}"
	fi
	local TARGET_DIR="$(image_target_dir "${ISO}")"

	# Ensure target directory exists early — needed by torrent/magnet/HTTP paths
	mkdir -p "${TARGET_DIR}"

	# Resolution order: TORRENT → MAGNET → HTTP
	# TORRENT: .torrent URL (stable, embeds webseed, infohash never drifts)
	# MAGNET:  magnet URI (needs MAGNET_PREFERRED or interactive opt-in)
	# HTTP:    plain curl download (always works)

	if [[ -n "${TORRENT_URL}" && -z "${TORRENT:-}" ]]; then
		TORRENT="${TORRENT_URL}"
	fi
	if [ -n "${TORRENT:-}" ] && command -v aria2c &>/dev/null; then
		echo "Downloading via .torrent file (preferred)..."
		# TORRENT may be URL + checksum metadata; aria2c must receive only the URL.
		local torrent_source="${TORRENT%% *}"
		if torrent_get "${torrent_source}" "${TARGET_DIR}" "${ISO}"; then
			if [ -n "${HASH}" ]; then
				check_hash "${ISO}" "${HASH}" || return $?
			fi
			dh_load_os "${OS}"
			if declare -F extract_ >/dev/null; then
				extract_ || return $?
			fi
			make_vm_config "${ISO}"
			return 0
		else
			echo "WARNING: Torrent download failed, trying magnet..." >&2
			# Fall through to magnet
		fi
	fi

	# --- 2. Try MAGNET (respects MAGNET_PREFERRED / DH_MAGNET_PREFERRED) ---
	local prefer_magnet="${MAGNET_PREFERRED:-${DH_MAGNET_PREFERRED:-}}"
	local use_magnet=0

	if [ -n "${MAGNET:-}" ] && command -v aria2c &>/dev/null; then
		if [[ "${prefer_magnet}" == "true" || "${prefer_magnet}" == "1" || "${prefer_magnet}" == "yes" ]]; then
			use_magnet=1
		elif [ -t 0 ]; then
			# Interactive terminal — ask the user (preserves current UX for humans)
			echo "Magnet link available. Use aria2c? [y/N]"
			read -r -n 1 ans
			echo
			if [[ "${ans,,}" == "y" ]]; then
				use_magnet=1
			fi
		else
			# Non-interactive (e.g. quicktest, CI) — default to HTTP unless explicitly opted in
			echo "INFO: Magnet link available but non-interactive; use DH_MAGNET_PREFERRED=1 to force magnet" >&2
		fi
	fi

	if [ "${use_magnet}" -eq 1 ]; then
		echo "Downloading via magnet link..."
		if torrent_get "${MAGNET}" "${TARGET_DIR}" "${ISO}"; then
			if [ -n "${HASH}" ]; then
				check_hash "${ISO}" "${HASH}" || return $?
			fi
			dh_load_os "${OS}"
			if declare -F extract_ >/dev/null; then
				extract_ || return $?
			fi
			make_vm_config "${ISO}"
			table_write ./TODO/all
			return 0
		else
			echo "WARNING: Magnet download failed, falling back to HTTP..." >&2
			# Fall through to HTTP path
		fi
	fi

	# --- 3. HTTP download path (final fallback) ---
	check_download_url "${URL}" || true
	web_get "${URL}" "${TARGET_DIR}" "${ISO}" || return $?
	if [ -n "${HASH}" ]; then
		check_hash "${ISO}" "${HASH}"
	fi
	dh_load_os "${OS}"
	if declare -F extract_ >/dev/null; then
		extract_ || return $?
	fi
	make_vm_config "${ISO}"
	table_write ./TODO/all
}

function create_config() {
	local VM_PATH="${1}"
	local INPUT="${2}"
	local FIXED_ISO=""

	OS="custom"
	if ! mkdir "${VM_PATH}" 2>/dev/null; then
		echo $"WARNING! This will overwrite content of directory: ${VM_PATH}"
	fi
	if [[ "${INPUT}" == "http://"* ]] || [[ "${INPUT}" == "https://"* ]]; then
		INPUT="$(web_redirect "${INPUT}")"
		if [[ "${INPUT}" == *".iso" ]] || [[ "${INPUT}" == *".img" ]] || [[ "${INPUT}" == *".ISO" ]] || [[ "${INPUT}" == *".IMG" ]]; then
			local DL_DIR="$(image_target_dir "${INPUT##*/}")"
			mkdir -p "${DL_DIR}"
			web_get "${INPUT}" "${DL_DIR}" || exit $?
			INPUT="${INPUT##*/}"
		else
			error_not_supported_image
		fi
	fi

	function moving_image() {
		echo $"Moving image to target dir"
		mv "$1" "$2"
	}

	local TARGET_DIR="$(image_target_dir "${INPUT##*/}")"
	mkdir -p "${TARGET_DIR}"
	if [[ "${INPUT}" == *".ISO" ]]; then
		moving_image "${INPUT}" "${TARGET_DIR}/${INPUT##*/}.iso"
		INPUT="${INPUT##*/}.iso"
		CUSTOM_IMAGE_TYPE="iso"
	elif [[ "${INPUT}" == *".iso" ]]; then
		moving_image "${INPUT}" "${TARGET_DIR}"
		CUSTOM_IMAGE_TYPE="iso"
	elif [[ "${INPUT}" == *".img" ]]; then
		moving_image "${INPUT}" "${VM_PATH}"
		CUSTOM_IMAGE_TYPE="img"
	elif [[ "${INPUT}" == *".qcow2" ]]; then
		moving_image "${INPUT}" "${VM_PATH}/disk.qcow2"
		INPUT="disk.qcow2"
		CUSTOM_IMAGE_TYPE="qcow2"
	else
		error_not_supported_image
	fi

	if [ ! -f "$(image_target_dir "${INPUT}")/${INPUT##*/}" ]; then
		echo $"ERROR! Image not found!"
		exit 1
	else
		INPUT="$(basename "${INPUT}")"
	fi

	echo $"Creating custom VM config for ${INPUT##*/}."
	case "${INPUT,,}" in
		*freebsd*) CUSTOM_OS="freebsd";;
		*kolibrios*) CUSTOM_OS="kolibrios";;
		*reactos*) CUSTOM_OS="reactos";;
		*windows-server*|*eval_oemret_x*|*eval_x*) CUSTOM_OS="windows-server";;
		*windows*|win*)
			CUSTOM_OS="windows"
			# Older windows 10 ISOs use the year followed by the month rather than the year & half). Match any text for language.
			if [ "${3}" != "--disable-unattended" ] && ( [ "${3}" == "--unattended" ] || grep -E -q 'Win(10|11)_([0-9]{2}H(1|2)|[0-9]{4})_[^.]*?(x64|x32)(v[0-9])?.iso' <<< "${INPUT}" ); then
				echo $"Creating unattended Windows installation files. To disable, pass --disable-unattended"
				echo
				echo $"Downloading VirtIO drivers..."
				web_get "https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso" "$(image_target_dir "virtio-win.iso")" || exit $?
				FIXED_ISO="virtio-win.iso"
				rm -f "${VM_PATH}/unattended.iso"
				unattended_windows "${VM_PATH}" || exit $?
			fi
			;;
		*) CUSTOM_OS="linux";;
	esac
	echo -e $"Selecting OS: ${CUSTOM_OS}.\nIf this is incorrect, please modify the config file to include the correct OS.\n"
	make_vm_config "${INPUT}" "${FIXED_ISO}"
}

