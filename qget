trap cleanup EXIT

if ((BASH_VERSINFO[0] < 4)); then
	echo $"Sorry, you need bash 4.0 or newer to run this script."
	exit 1
fi

QUICKEMU=$(resolve_quickemu)
I18NS=()
OPERATION=""
NORMALISED_HOST_ARCH="$(_host_arch)"
ARCH="${NORMALISED_HOST_ARCH}"
ARCH_EXPLICIT="no"
export ARCH NORMALISED_HOST_ARCH
CURL=$(command -v curl)
if [ ! -x "${CURL}" ]; then
	echo $"ERROR! curl not found. Please install curl"
	exit 1
fi
CURL_VERSION=$("${CURL}" --version | head -n 1 | cut -d' ' -f2)

# Global flags that may appear before the command.
while [ "$#" -gt 0 ]; do
	case "${1}" in
		--templates|-templates)
			# Read the distro metadata straight from templates/ instead of
			# the generated public/ files. The templates discover releases
			# and editions live, so this always reflects the current
			# upstream state but needs network access and is slower.
			DH_USE_TEMPLATES="yes"
			export DH_USE_TEMPLATES
			shift
			;;
		-a|--arch)
			# The architecture may be given before or after the command,
			# so it is handled here as well as in the command dispatch.
			if [ -z "${2:-}" ]; then
				echo "ERROR! --arch requires an architecture." >&2
				exit 1
			fi
			ARCH="$(_upstream_to_qarch "${2}")"
			ARCH_EXPLICIT="yes"
			export ARCH
			shift 2
			;;
		*) break ;;
	esac
done

# Note: Old commands `list`, `list_csv`, `list_json` are kept for backwards compatibility
# They now map to the new `--list`, `--list-csv`, `--list-json` options
case "${1}" in
	--ui)
		OPERATION="ui"
		shift
		run_ui
		;;

	--download|-download)
		OPERATION="download"
		shift
		;;

	--create-config|-create-config)
		OPERATION="config"
		shift
		create_config "${@}"
		exit $?
		;;

	--open-homepage|-open-homepage|-o)
		shift
		open_homepage "${1}"
		;;

	--show|-show)
		shift
		SHOW_ARCH="" SHOW_RELEASE=""
		while [[ "${1:-}" == "--arch" || "${1:-}" == "--release" || "${1:-}" == "--plain" ]]; do
			case "${1}" in
				--arch)
					if [ -z "${2:-}" ] || [[ "${2}" == --* ]]; then
						echo $"ERROR! --arch requires an architecture." >&2
						exit 1
					fi
					SHOW_ARCH="${2}"
					shift 2
					;;
				--release)
					if [ -z "${2:-}" ] || [[ "${2}" == --* ]]; then
						echo $"ERROR! --release requires a release." >&2
						exit 1
					fi
					SHOW_RELEASE="${2}"
					shift 2
					;;
				--plain) QGET_PLAIN=1; export QGET_PLAIN; shift ;;
			esac
		done
		if [ -z "${1}" ]; then
			if [ -n "${SHOW_ARCH}${SHOW_RELEASE}" ]; then
				echo "ERROR! --arch and --release require an OS."
				exit 1
			fi
			for OS in $(os_support); do
				show_os_info "${OS}"
			done
		else
			show_os_info "${1}" "${SHOW_ARCH}" "${SHOW_RELEASE}" || exit 1
		fi
		exit 0
		;;

	--version|-version)
		WHERE=$(dirname "${BASH_SOURCE[0]}")
		"${WHERE}/quickemu" --version
		exit 0
		;;

	--help|-help|--h|-h)
		help_message
		exit 0
		;;

	--url|-url)
		OPERATION="show"
		shift
		if [ -z "${1}" ]; then
			for OS in $(os_support); do
				(test_all "${OS}")
			done
			exit 0
		fi
		# The release and edition are optional; without them every
		# combination of the distro is listed.
		OS="${1}"
		RELEASE="${2:-}"
		EDITION="${3:-}"
		test_all "${OS}"
		exit 0
		;;

	--check|-check)
		OPERATION="test"
		shift
		if [ -z "${1}" ]; then
			for OS in $(os_support); do
				(test_all "${OS}")
			done
			exit 0
		fi
		OS="${1}"
		RELEASE="${2:-}"
		EDITION="${3:-}"
		test_all "${OS}"
		exit 0
		;;

	--list-os|-list-os)
		os_support
		exit 0
		;;

	--list-csv|-list-csv|list|list_csv)
		list_csv
		;;

	--list-json|-list-json|list_json)
		list_json
		;;

	--list|-list)
		list_supported
		;;

	--list-category|-list-category)
		shift
		[ -z "${1}" ] && { echo $"ERROR! Specify a category filter (e.g. Gaming, Security, Server)." >&2; exit 1; }
		list_by_category "${1}"
		;;

	--qemu-version|-qemu-version) find_latest_qemu_version
		exit 0
		;;

	-a|--arch)
		ARCH="$(_upstream_to_qarch "${2}")"
		ARCH_EXPLICIT="yes"
		shift 2
		;;

	-*)
		error_not_supported_argument
		;;
esac

run_itself "$@"

