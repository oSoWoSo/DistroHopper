run_itself() {
	local DOWNLOAD_SPEC
	if [ -n "${1}" ]; then
		OS="${1,,}"
	else
		error_specify_os
	fi

	os_supported
	dh_load_os "${OS}"

	if [ -n "${2}" ]; then
		RELEASE="${2}"
		validate_arch
		if [ "${OS}" == "bedrock-linux" ]; then
			validate_release releases_
			BASE_OS="${3}"
			if [ "${BASE_OS}" == "prepared" ]; then
				BASE_VM_CONF="${4}"
				create_bedrock_from_vm
				return
			fi
			local BASE_OS_OPTIONS
			BASE_OS_OPTIONS="$(editions_)"
			if [[ ! " ${BASE_OS_OPTIONS} " == *" ${BASE_OS} "* ]]; then
				local BASE_PROMPT="Select a Bedrock base for ${ARCH}:"
				[ -n "${BASE_OS}" ] && BASE_PROMPT="${BASE_OS} is unavailable on ${ARCH}; select a supported base:"
				BASE_OS=$(bedrock_choose_value "${BASE_PROMPT}" "${BASE_OS_OPTIONS}") || {
					echo $"ERROR! ${BASE_OS} is not a supported Bedrock base on ${ARCH}." >&2
					echo $"Supported bases: ${BASE_OS_OPTIONS}" >&2
					exit 1
				}
			fi
			EDITION="${BASE_OS}"
			BASE_RELEASE="${4}"
			BASE_EDITION="${5}"
			select_bedrock_base
			VM_PATH="${OS}-${RELEASE}-${BASE_OS}-${BASE_RELEASE}"
			[ -n "${BASE_EDITION}" ] && VM_PATH+="-${BASE_EDITION}"
			VM_PATH+="$(arch_suffix)"
			check_vm_folder_name "${VM_PATH}"
			DOWNLOAD_SPEC=$("get_") || return $?
			create_vm "${DOWNLOAD_SPEC}" || return $?
			if [ -n "${QGET_DEFAULT_VM_CONFIG:-}" ] && [ -f "${QGET_DEFAULT_VM_CONFIG}" ] && [ -f "${VM_PATH}.conf" ]; then
				cat "${QGET_DEFAULT_VM_CONFIG}" >> "${VM_PATH}.conf"
			fi
			return
		fi
		VM_PATH="${OS}-${RELEASE}$(arch_suffix)"
		check_vm_folder_name "${VM_PATH}"
		# If the OS has an editions_() function, use it.
		if [[ $(type -t editions_) == function ]] || [ -n "${EDITIONS:-}" ]; then
			validate_release releases_
			EDITIONS=$(dh_editions "${RELEASE}" "${ARCH}")
			if [ -n "${3}" ]; then
				EDITION="${3}"
				if [[ ! "${EDITIONS[*]}" = *"${EDITION}"* ]]; then
					echo -e $"ERROR! ${EDITION} is not a supported ${PRETTY} edition on ${ARCH}.\n"
					echo -n $' - Supported editions: '
					for EDITION in "${EDITIONS[@]}"; do
						echo -n "${EDITION} "
					done
					echo ""
					exit 1
				fi
			else
				show_os_info "${OS}" "${ARCH}" "${RELEASE}"
				echo -e $"\nERROR! You must specify an edition for ${PRETTY} on ${ARCH}."
				echo $"Use: qget --show --arch ${ARCH} --release ${RELEASE} ${OS}"
				exit 1
			fi
			handle_missing
			VM_PATH="${OS}-${RELEASE}-${EDITION}$(arch_suffix)"
			DOWNLOAD_SPEC=$("get_" "${EDITION}") || return $?
			create_vm "${DOWNLOAD_SPEC}" || return $?
		elif [ "${OS}" == "macos" ]; then
			# macOS doesn't use create_vm()
			validate_release releases_
			get_
		elif [[ "${OS}" == *"ubuntu-server"* ]]; then
			# (Comes before regular Ubuntu, or the code tries to download the desktop) #
			# Ubuntu doesn't use create_vm()
			validate_release releases_
			get_
		elif [[ "${OS}" == *"ubuntu"* ]]; then
			# Ubuntu doesn't use create_vm()
			validate_release releases_
			get_
		elif [[ "${OS}" == "windows"* ]]; then
			I18N="English International"
			languages_"${OS}"
			if [ -n "${3}" ]; then
				I18N="${3}"
				if [[ ! "${I18NS[*]}" = *"${I18N}"* ]]; then
					error_not_supported_lang
				fi
				VM_PATH="$(echo "${OS}-${RELEASE}-${I18N// /-}" | tr -d '()')$(arch_suffix)"
			fi
			validate_release releases_
			get_
		else
			validate_release releases_
			DOWNLOAD_SPEC=$("get_") || return $?
			create_vm "${DOWNLOAD_SPEC}" || return $?
		fi
	else
		error_specify_release
	fi
}

# shellcheck disable=SC2046
function run_ui() {
	if ! command -v gum &> /dev/null; then
		echo $"gum could not be found, please install it first"
		exit 1
	fi
	OS=$(gum filter --height=17 --header="Select an OS:" $(os_support))
	#os_info "${OS}" > "$TMPFILE"
	dh_load_os "${OS}"
	ARCHS="${QEMU_ARCH:-}"
	if [ -z "${ARCHS}" ] && [[ $(type -t arch_) == function ]]; then
		ARCHS="$(arch_)"
	fi
	ARCHS="${ARCHS:-$(_host_arch)}"
	ARCH_LIST=()
	read -r -a ARCH_LIST <<< "${ARCHS}"
	if [ "${#ARCH_LIST[@]}" -gt 1 ]; then
		ARCH=$(printf '%s\n' "${ARCH_LIST[@]}" | gum choose --height=9 --header="Select $OS architecture:")
		[ -z "${ARCH}" ] && return 0
	else
		ARCH="${ARCH_LIST[0]}"
	fi
	RELEASES="$(dh_releases "${ARCH}")"
	RELEASE=$(gum filter --height=9 --header="Select $OS release:" ${RELEASES})
	[ -z "${RELEASE}" ] && return 0
	EDITIONS=$(dh_editions "${RELEASE}" "${ARCH}")
	[ "${OS}" == "bedrock-linux" ] && EDITIONS="${EDITIONS} prepared"
	if [ -n "${EDITIONS}" ]; then
		local EDITION_HEADER="Select ${OS} ${RELEASE} edition:"
	[ "${OS}" == "bedrock-linux" ] && EDITION_HEADER="Select Bedrock base distro or prepared VM:"
		EDITION=$(gum filter --height=9 --header="${EDITION_HEADER}" ${EDITIONS})
		[ -z "${EDITION}" ] && return 0
		echo ''
		run_itself "${OS}" "${RELEASE}" "${EDITION}"
	else
		echo ''
		run_itself "${OS}" "${RELEASE}"
	fi
}

