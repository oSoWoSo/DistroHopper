#!/usr/bin/env bash
# SC2317: Command appears to be unreachable. Check usage (or ignore if invoked indirectly).
#  - https://www.shellcheck.net/wiki/SC2317
#  - Disable globally because many functions are called indirectly
# shellcheck disable=SC2317
# shellcheck source=lib.sh
SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]:-$0}")")"
source "${SCRIPT_DIR}/lib.sh"

# Load DistroHopper user config so qget honors RAMDISK / ISO_DIR settings
if [ -f "${HOME}/.config/dh/config" ]; then
	# shellcheck source=/dev/null
	. "${HOME}/.config/dh/config"
fi

# Latest cherrypick (or not) commit. Start from here...
# https://github.com/quickemu-project/quickemu/tree/3da9edc9953340622db23be4661aefa4cd0632f2

export TEXTDOMAIN=qget
RESOURCE_DIR="${APPDIR:-${SCRIPT_DIR}}"
export PUBLIC_DIR="${PUBLIC_DIR:-${RESOURCE_DIR}/public}"
TEMPLATES_DIR="${TEMPLATES_DIR:-${RESOURCE_DIR}/templates}"
# Fall back to templates when generated public/ metadata is unavailable.
if [ "${DH_USE_TEMPLATES:-no}" != "yes" ] && [ ! -d "${PUBLIC_DIR}" ] && [ -d "${TEMPLATES_DIR}" ]; then
	export DH_USE_TEMPLATES="yes"
fi
if [[ -n $Q_DEBUG ]]; then
	export TEXTDOMAINDIR="${PWD}/locale"
else
	export TEXTDOMAINDIR=/usr/share/locale
fi
qgetVersion="0.9"

function cleanup() {
	if [ -n "$(jobs -p)" ]; then
		kill "$(jobs -p)" 2>/dev/null
	fi
}

function detect_capabilities() {
	# Support sixel (zellij)
	HAS_CHAFA=0
	HAS_NERD_FONT=0
	command -v chafa >/dev/null && HAS_CHAFA=1
	if command -v fc-match &>/dev/null; then
		fc-match monospace 2>/dev/null | grep -qi 'nerd\|NF' && HAS_NERD_FONT=1
	fi
	[[ -n "${KITTY_WINDOW_ID}" || "${TERM}" == "xterm-kitty" || -n "${WEZTERM_PANE}" ]] && HAS_NERD_FONT=1
}

function show_os_info() {
	local os="${1}" requested_arch="${2:-}" requested_release="${3:-}"
	if ! dh_load_os "${os}"; then
		echo $"ERROR! ${os} is not a supported OS." >&2
		return 1
	fi
	if [ -n "${requested_arch}" ]; then
		ARCH=$(_upstream_to_qarch "${requested_arch}")
		if [[ $(type -t arch_) == function ]] && ! arch_ | tr ' ' '\n' | grep -Fxq "${ARCH}"; then
			local supported_arches="${QEMU_ARCH:-}"
			[[ $(type -t arch_) == function ]] && supported_arches=$(arch_)
			echo "ERROR! ${ARCH} is not a supported ${PRETTY} architecture."
			echo "Supported architectures: ${supported_arches:-not declared}."
			return 1
		fi
		# The releases and editions of the selected architecture.
		# Edition queries already name a discovered release. In live mode,
		# do not rescan/probe the entire upstream archive for every query.
		if [ -n "${requested_release}" ] && [ "${DH_USE_TEMPLATES:-no}" == yes ]; then
			RELEASES="${requested_release}"
		else
			RELEASES="$(dh_releases "${ARCH}")"
		fi
		if [ -n "${requested_release}" ]; then
			EDITIONS="$(dh_editions "${requested_release}" "${ARCH}")"
		else
			EDITIONS="$(dh_editions "" "${ARCH}")"
		fi
	else
		if [ -n "${requested_release}" ] && [ "${DH_USE_TEMPLATES:-no}" == yes ]; then
			RELEASES="${requested_release}"
		else
			RELEASES="$(dh_releases "")"
		fi
		EDITIONS="$(dh_editions "${requested_release}")"
	fi
	[ "${os}" == "bedrock-linux" ] && EDITIONS="${EDITIONS} prepared"
	# The architecture list: the static value, or the template's arch_().
	if [ -z "${QEMU_ARCH:-}" ] && [[ $(type -t arch_) == function ]]; then
		QEMU_ARCH="$(arch_)"
	fi
	# The editions one per line. An edition can contain a space (e.g.
	# "Brazilian Portuguese"), so the space separated EDITIONS value cannot
	# be split apart again — this list can.
	local _editions_list=""
	if [ "${QGET_PLAIN:-}" == "1" ]; then
		if [ -z "${requested_arch}${requested_release}" ] && [ -n "${EDITIONS_LIST:-}" ]; then
			_editions_list="${EDITIONS_LIST}"
		elif [[ "${EDITIONS}" == *$'\n'* ]] || { [ -n "${EDITIONS}" ] && printf '%s\n' "${EDITIONS_LIST:-}" | grep -Fxq "${EDITIONS}"; }; then
			_editions_list="${EDITIONS}"
		elif [ -n "${EDITIONS_LIST:-}" ]; then
			# Scoped static metadata is space-joined. Recover its entries using
			# the lossless global list, preferring the longest matching name.
			local remaining="${EDITIONS}" candidate best
			while [ -n "$remaining" ]; do
				best=""
				while IFS= read -r candidate; do
					[ -n "$candidate" ] || continue
					if [[ "$remaining" == "$candidate" || "$remaining" == "$candidate "* ]]; then
						((${#candidate} > ${#best})) && best="$candidate"
					fi
				done <<< "$EDITIONS_LIST"
				# Compatibility with old metadata missing a global-list entry.
				[ -n "$best" ] || best="${remaining%% *}"
				_editions_list+="${_editions_list:+$'\n'}${best}"
				remaining="${remaining#"$best"}"
				remaining="${remaining# }"
			done
		else
			# Template edition functions commonly return a space-separated list.
			_editions_list=$(printf '%s\n' "${EDITIONS}" | tr ' ' '\n' | awk 'NF')
		fi
	else
		_editions_list="${EDITIONS}"
	fi
	detect_capabilities
	echo
	echo " ${PRETTY}"
	if [[ "${HAS_CHAFA}" == "1" ]] && [[ -f "icons/${ICON}" ]]; then
		chafa -s 5x5 "icons/${ICON}"
	fi
	local cols
	cols=$(tput cols 2>/dev/null || echo 80)
	# The plain output is meant to be parsed by other programs: every value
	# stays on a single line, so a long release or edition list is never
	# wrapped and truncated. The default output is wrapped for humans.
	local _wrap=1
	[ "${QGET_PLAIN:-}" == "1" ] && _wrap=0
	if [ -n "${requested_arch}" ]; then
		echo $"Category:    ${CATEGORY}"
		echo $"Based of:    ${BASEDOF}"
		echo $"Website:     ${HOMEPAGE}"
		echo $"Credentials: ${CREDENTIALS}"
		[ -n "${QEMU_ARCH}" ] && echo $"Archs:       ${QEMU_ARCH}"
		echo $"Releases:    ${RELEASES}"
		[ -n "${EDITIONS}" ] && echo $"Editions:    ${EDITIONS}"
	else
		echo $"Category:    ${CATEGORY}"
		echo $"Based of:    ${BASEDOF}"
		echo $"Website:     ${HOMEPAGE}"
		echo $"Credentials: ${CREDENTIALS}"
		if [ "${_wrap}" -eq 1 ]; then
			[ -n "${QEMU_ARCH}" ] && echo $"Archs:       ${QEMU_ARCH}" | fmt -w "$cols"
			echo $"Releases:    ${RELEASES}" | fmt -w "$cols"
			if [ -n "${EDITIONS}" ]; then
				if [ "${os}" == "bedrock-linux" ]; then
					echo $"Editions:    ${EDITIONS}"
				else
					echo $"Editions:    ${EDITIONS}" | fmt -w "$cols"
				fi
			fi
		else
			[ -n "${QEMU_ARCH}" ] && echo $"Archs:       ${QEMU_ARCH}"
			echo $"Releases:    ${RELEASES}"
			[ -n "${EDITIONS}" ] && echo $"Editions:    ${EDITIONS}"
			# The editions one per line, for the front-ends to pick from.
			# It is the last field of the plain output, so it runs to the
			# end of the output.
			[ -n "${_editions_list}" ] && printf 'EditionsList:\n%s\n' "${_editions_list}"
		fi
	fi
	if [ "${QGET_PLAIN:-}" == "1" ]; then
		if [ -n "${requested_arch}" ]; then
			[ -n "${_editions_list}" ] && printf 'EditionsList:\n%s\n' "${_editions_list}"
		fi
		[ -n "${RSS}" ] && echo $"RSS:         ${RSS}"
		[ -n "${DW}" ]  && echo $"DistroWatch: ${DW}"
		echo $"Description: ${DESCRIPTION}"
		return 0
	fi
	[ -n "${RSS}" ]      && echo $"RSS:         ${RSS}"
	[ -n "${DW}" ]       && echo $"DistroWatch: ${DW}"
	echo $"Description: ${DESCRIPTION}"
	rosette_info "${os}"
}
function os_support() {
	if [ "${DH_USE_TEMPLATES:-no}" == "yes" ]; then
		DIR="${TEMPLATES_DIR}"
	else
		DIR="${PUBLIC_DIR}"
	fi
	for file in "$DIR"/*; do
		if [[ -f "$file" ]] && [[ ! "$file" =~ tmp_ ]]; then
			filename="${file##*/}"
			echo "$filename"
		fi
	done
}

function error_specify_os() {
	echo $"ERROR! You must specify an operating system."
	echo $"- Supported Operating Systems:"
	os_support | fmt -w $(tput cols)
	echo -e $"\nTo see all possible arguments, use:\n   qget -h  or  qget --help"
	exit 1
}

function os_supported() {
	#if [[ ! "$(os_support)" =~ ${OS} ]]; then
	if [[ ! $'\n'"$(os_support)"$'\n' =~ $'\n'"${OS}"$'\n' ]]; then
		echo -e $"ERROR! ${OS} is not a supported OS.\n"
		# Say where we looked, otherwise an exported PUBLIC_DIR pointing at a
		# stale/other checkout is indistinguishable from a missing template.
		echo -e $"Looked in: ${PUBLIC_DIR}  (qget: ${BASH_SOURCE[0]:-$0})\n"
		if [[ -f "${SCRIPT_DIR}/public/${OS}" ]]; then
			echo -e $"NOTE: ${OS} exists in this checkout at ${SCRIPT_DIR}/public/${OS}"
			echo -e $"      but PUBLIC_DIR points elsewhere. Try: unset PUBLIC_DIR\n"
		fi
		os_support | fmt -w $(tput cols 2>/dev/null || echo 80)
		exit 1
	fi
}

function error_specify_release() {
	dh_load_os "${OS}"
	local cols
	cols=$(tput cols 2>/dev/null || echo 80)
	echo -e $"\nERROR! You must specify a release for ${PRETTY:-${OS}}."
	echo $"Releases:    ${RELEASES}" | fmt -w "$cols"
	if [ -n "${EDITIONS}" ]; then
		echo $"Editions:    ${EDITIONS}" | fmt -w "$cols"
	fi
	exit 1
}

function error_not_supported_release() {
	#if [[ ! "${RELEASES[*]}" =~ ${RELEASE} ]]; then
	if [[ ! " ${RELEASES} " =~ " ${RELEASE} " ]]; then
		echo -e $"ERROR! ${DISPLAY_NAME} ${RELEASE} is not a supported release.\n"
		echo -n $' - Supported releases: '
		echo "${RELEASES}"
		exit 1
	fi
}

function error_not_supported_arch() {
	echo -e $"ERROR! ${PRETTY} does not support the ${ARCH} architecture.\n"
	echo -n $' - Supported architectures: '
	local SUPPORTED_ARCHS
	SUPPORTED_ARCHS="$(arch_ 2>/dev/null)"
	[ -n "${SUPPORTED_ARCHS}" ] && echo "${SUPPORTED_ARCHS}" || echo "(none declared)"
	echo $" - Inspect architecture-specific choices with: qget --show --arch ${ARCH} ${OS}"
	exit 1
}

# Validate an explicitly requested --arch against the OS arch_() list.
# Called only when the user passed --arch, so the host-default arch can never
# hard-fail an amd64-only OS on an arm64 host.
function validate_arch() {
	[ "${ARCH_EXPLICIT}" == "yes" ] || return 0
	declare -F arch_ &>/dev/null || return 0
	local SUPPORTED_ARCHS
	SUPPORTED_ARCHS="$(arch_ 2>/dev/null)"
	[ -n "${SUPPORTED_ARCHS}" ] || return 0
	if [[ ! " ${SUPPORTED_ARCHS} " =~ " ${ARCH} " ]]; then
		error_not_supported_arch
	fi
}

function error_not_supported_lang() {
	echo -e $"ERROR! ${I18N} is not a supported ${PRETTY} language\n"
	echo -n $' - Editions: '
	for I18N in "${I18NS[@]}"; do
		echo -n "${I18N} "
	done
	exit 1
}

function error_not_supported_argument() {
	echo $"ERROR! Not supported argument"
	echo $"To see all possible arguments, use:"
	echo $"   qget -h  or  qget --help"
	exit 1
}

function error_unable_to_create_dir() {
	echo $"ERROR! Unable to create directory ${DIR}"
	exit 1
}

function error_not_supported_image() {
	echo $"ERROR! Only ISO,IMG and QCOW2 file types are supported for --create-config"
	exit 1
}

function is_valid_language() {
	local I18N=""
	local PASSED_I18N="${1}"
	for I18N in "${I18NS[@]}"; do
		if [[ "${I18N}" == "${PASSED_I18N}" ]]; then
			return 0
		fi
	done
	return 1
}

function handle_missing() {
	# Handle odd missing Fedora combinations
	case "${OS}" in
		fedora-linux)
			# First we need to handle the Beta naming kludge
			if [[ "${RELEASE}" == *"_Beta" ]]; then
				NRELEASE="${RELEASE/_Beta/}"
				else
				NRELEASE="${RELEASE}"
			fi
			if [[ "${NRELEASE}" -lt 40 && "${EDITION}" == "Onyx" ]] || [[ "${NRELEASE}" -lt 40 && "${EDITION}" == "Sericea" ]]; then
				echo $"ERROR! Unsupported combination"
				echo $"       Fedora ${RELEASE} ${EDITION} is not available, please choose another Release or Edition"
				exit 1
			fi
			;;
	esac
}

function validate_release() {
	local DISPLAY_NAME=""
	local RELEASE_GENERATOR="${1}"
	# The list is kept in the global RELEASES, which is what
	# error_not_supported_release reports.
	DISPLAY_NAME="${PRETTY}"
	# The static release list of the selected architecture, or the live one
	# from the template when running in template mode.
	RELEASES="$(dh_releases "${ARCH}")"
	if [ -z "${RELEASES}" ] && [[ $(type -t "${RELEASE_GENERATOR}") == function ]]; then
		RELEASES="$(${RELEASE_GENERATOR})"
	fi
	error_not_supported_release
}
function bedrock_base_values() {
	local BASE_OS="${1}"
	local VALUE_TYPE="${2}"
	(
		dh_load_os "bedrock-linux"
		case "${VALUE_TYPE}" in
			releases) _base_releases_ "${BASE_OS}";;
			editions) _base_editions_ "${BASE_OS}";;
		esac
	)
}

function bedrock_choose_value() {
	local LABEL="${1}"
	local OPTIONS="${2}"
	local CHOICE=""
	if command -v gum >/dev/null && [ -t 0 ]; then
		CHOICE=$(printf '%s\n' ${OPTIONS} | gum filter --header="${LABEL}")
	elif command -v fzf >/dev/null && [ -t 0 ]; then
		CHOICE=$(printf '%s\n' ${OPTIONS} | fzf --prompt="${LABEL} ")
	elif command -v yad >/dev/null && [ -n "${DISPLAY:-}" ]; then
		local OPTIONS_FMT="${OPTIONS// /!}"
		CHOICE=$(yad --form --title="Bedrock base selection" \
			--field="${LABEL}:CB" "${OPTIONS_FMT}" \
			--button="Select:0" --button="Cancel:1" | cut -d'|' -f1)
	else
		return 1
	fi
	[ -n "${CHOICE}" ] || return 1
	printf '%s\n' "${CHOICE}"
}

function bedrock_vm_config_value() {
	local VM_CONF="${1}"
	local KEY="${2}"
	awk -v key="${KEY}" '
		{
			line=$0
			sub(/^[[:space:]]*/, "", line)
			split(line, fields, "=")
			if (fields[1] == key) {
				value=substr(line, index(line, "=") + 1)
				sub(/^[[:space:]]+/, "", value)
				sub(/[[:space:]]+$/, "", value)
				if (value ~ /^".*"$/) value=substr(value, 2, length(value) - 2)
				print value
				exit
			}
		}
	' "${VM_CONF}"
}

function bedrock_vm_disk_path() {
	local VM_CONF="${1}"
	local DISK_PATH=""
	DISK_PATH=$(bedrock_vm_config_value "${VM_CONF}" disk_img)
	[ -z "${DISK_PATH}" ] && DISK_PATH="$(dirname "${VM_CONF}")/disk.qcow2"
	[[ "${DISK_PATH}" != /* ]] && DISK_PATH="$(dirname "${VM_CONF}")/${DISK_PATH}"
	printf '%s\n' "${DISK_PATH}"
}

function bedrock_vm_config_is_usable() {
	local VM_CONF="${1}"
	local GUEST=""
	local VM_ARCH=""
	local DISK_PATH=""
	GUEST=$(bedrock_vm_config_value "${VM_CONF}" guest_os)
	[ "${GUEST}" == "linux" ] || return 1
	VM_ARCH=$(bedrock_vm_config_value "${VM_CONF}" arch)
	case "${VM_ARCH:-x86_64}" in
		x86_64|amd64) VM_ARCH="amd64";;
		aarch64|arm64) VM_ARCH="arm64";;
		*) return 1;;
	esac
	[ "${VM_ARCH}" == "${ARCH}" ] || return 1
	DISK_PATH=$(bedrock_vm_disk_path "${VM_CONF}")
	[ -f "${DISK_PATH}" ]
}

function bedrock_choose_existing_vm() {
	local VM_DIR="${VMS_DIR:-$PWD}"
	local VM_CONF=""
	local CHOICE=""
	local VM_OPTIONS=""
	local -a VM_CONFIGS=()
	local -a VM_NAMES=()
	while IFS= read -r -d '' VM_CONF; do
		[[ "$(basename "${VM_CONF}")" == bedrock-*.conf ]] && continue
		bedrock_vm_config_is_usable "${VM_CONF}" || continue
		VM_CONFIGS+=("${VM_CONF}")
		VM_NAMES+=("$(basename "${VM_CONF}")")
	done < <(find "${VM_DIR}" -maxdepth 1 -type f -name '*.conf' -print0 2>/dev/null)
	if [ "${#VM_CONFIGS[@]}" -eq 0 ]; then
		echo $"ERROR! No prepared Linux VM configs with an existing disk found in ${VM_DIR}." >&2
		return 1
	fi
	if command -v gum >/dev/null && [ -t 0 ]; then
		CHOICE=$(printf '%s\n' "${VM_NAMES[@]}" | gum filter --header="Select prepared Linux VM:")
	elif command -v fzf >/dev/null && [ -t 0 ]; then
		CHOICE=$(printf '%s\n' "${VM_NAMES[@]}" | fzf --prompt="Select prepared Linux VM: ")
	elif command -v yad >/dev/null && [ -n "${DISPLAY:-}" ]; then
		local IFS='!'
		VM_OPTIONS="${VM_NAMES[*]}"
		CHOICE=$(yad --form --title="Bedrock base selection" \
			--field="Select prepared Linux VM (.conf):CB" "${VM_OPTIONS}" \
			--button="Select:0" --button="Cancel:1" | cut -d'|' -f1)
	else
		echo $"ERROR! Select a prepared VM config from a terminal UI or GUI." >&2
		return 1
	fi
	[ -n "${CHOICE}" ] || return 1
	for ((i = 0; i < ${#VM_NAMES[@]}; i++)); do
		if [ "${VM_NAMES[$i]}" == "${CHOICE}" ]; then
			printf '%s\n' "${VM_CONFIGS[$i]}"
			return 0
		fi
	done
	return 1
}

function create_bedrock_from_vm() {
	if [ "${OPERATION}" == "download" ]; then
		echo $"ERROR! A prepared VM base cannot be used in download-only mode." >&2
		exit 1
	fi
	local VM_CONF="${BASE_VM_CONF:-}"
	local BASE_NAME=""
	local BASE_DISK=""
	local PID_FILE=""
	local PID=""
	local DISK_PATH=""
	local DISK_QUOTED=""
	[ -n "${VM_CONF}" ] || VM_CONF=$(bedrock_choose_existing_vm) || exit 1
	if [[ "${VM_CONF}" != /* && ! -f "${VM_CONF}" && -f "${VMS_DIR:-$PWD}/${VM_CONF}" ]]; then
		VM_CONF="${VMS_DIR:-$PWD}/${VM_CONF}"
	fi
	if [ ! -f "${VM_CONF}" ] || ! bedrock_vm_config_is_usable "${VM_CONF}"; then
		echo $"ERROR! ${VM_CONF} is not a prepared Linux VM config with an existing disk for ${ARCH}." >&2
		exit 1
	fi
	BASE_DISK=$(bedrock_vm_disk_path "${VM_CONF}")
	BASE_NAME=$(basename "${VM_CONF}" .conf)
	PID_FILE="$(dirname "${BASE_DISK}")/${BASE_NAME}.pid"
	if [ -r "${PID_FILE}" ]; then
		read -r PID < "${PID_FILE}"
		if [[ "${PID}" =~ ^[0-9]+$ ]] && kill -0 "${PID}" 2>/dev/null; then
			echo $"ERROR! Stop ${BASE_NAME} before using it as a Bedrock base." >&2
			exit 1
		fi
	fi
	command -v qemu-img >/dev/null 2>&1 || {
		echo $"ERROR! qemu-img is required to copy a prepared VM disk." >&2
		exit 1
	}
	local TARGET_NAME
	TARGET_NAME=$(printf '%s' "${BASE_NAME}" | tr -cs '[:alnum:]._+-' '-')
	TARGET_NAME="${TARGET_NAME#-}"
	TARGET_NAME="${TARGET_NAME%-}"
	VM_PATH="${OS}-${RELEASE}-prepared-${TARGET_NAME}$(arch_suffix)"
	check_vm_folder_name "${VM_PATH}"
	if [ -e "${VM_PATH}.conf" ] || [ -e "${VM_PATH}" ]; then
		echo $"ERROR! ${VM_PATH} already exists; refusing to overwrite it." >&2
		exit 1
	fi
	mkdir "${VM_PATH}" || exit 1
	echo $"Copying prepared VM disk from ${BASE_NAME}; the source VM remains unchanged."
	if ! qemu-img convert -p -O qcow2 "${BASE_DISK}" "${VM_PATH}/disk.qcow2"; then
		rm -f "${VM_PATH}/disk.qcow2"
		rmdir "${VM_PATH}" 2>/dev/null
		echo $"ERROR! Could not copy prepared VM disk." >&2
		exit 1
	fi
	DISK_PATH="$(realpath "${VM_PATH}/disk.qcow2")"
	printf -v DISK_QUOTED '%q' "${DISK_PATH}"
	local ARCH_LINE=""
	if [ -n "${ARCH:-}" ] && [ "${ARCH}" != "amd64" ]; then
		ARCH_LINE="arch=\"$(_qarch_to_upstream "${ARCH}")\""
	fi
	CONF_FILE="${VM_PATH}.conf"
	cat > "${CONF_FILE}" <<EOF
#!${QUICKEMU} --vm
guest_os="linux"
disk_img=${DISK_QUOTED}
${ARCH_LINE}
EOF
	chmod u+x "${CONF_FILE}"
	declare -F config_ >/dev/null && config_
	if [ -n "${QGET_DEFAULT_VM_CONFIG:-}" ] && [ -f "${QGET_DEFAULT_VM_CONFIG}" ]; then
		cat "${QGET_DEFAULT_VM_CONFIG}" >> "${CONF_FILE}"
	fi
	BASE_OS="prepared"
	BASE_RELEASE="${BASE_NAME}"
	BASE_EDITION=""
	extract_
	echo $"Bedrock VM config created: ${CONF_FILE}"
}


function select_bedrock_base() {
	local BASE_RELEASES=""
	local BASE_EDITIONS=""
	BASE_RELEASES=$(bedrock_base_values "${BASE_OS}" releases | xargs)
	if [ -z "${BASE_RELEASES}" ]; then
		echo $"ERROR! Could not find releases for Bedrock base ${BASE_OS}." >&2
		exit 1
	fi
	if [ -z "${BASE_RELEASE}" ]; then
		BASE_RELEASE=$(bedrock_choose_value "Select ${BASE_OS} base release:" "${BASE_RELEASES}") || {
			echo $"ERROR! Specify the ${BASE_OS} base release." >&2
			echo $"Supported releases: ${BASE_RELEASES}" >&2
			exit 1
		}
	fi
	if [[ ! " ${BASE_RELEASES} " == *" ${BASE_RELEASE} "* ]]; then
		echo $"ERROR! ${BASE_RELEASE} is not a supported ${BASE_OS} base release." >&2
		echo $"Supported releases: ${BASE_RELEASES}" >&2
		exit 1
	fi

	BASE_EDITIONS=$(bedrock_base_values "${BASE_OS}" editions | xargs)
	if [ -n "${BASE_EDITIONS}" ]; then
		if [ -z "${BASE_EDITION}" ]; then
			BASE_EDITION=$(bedrock_choose_value "Select ${BASE_OS} ${BASE_RELEASE} edition:" "${BASE_EDITIONS}") || {
				echo $"ERROR! Specify the ${BASE_OS} base edition." >&2
				echo $"Supported editions: ${BASE_EDITIONS}" >&2
				exit 1
			}
		fi
		if [[ ! " ${BASE_EDITIONS} " == *" ${BASE_EDITION} "* ]]; then
			echo $"ERROR! ${BASE_EDITION} is not a supported ${BASE_OS} base edition." >&2
			echo $"Supported editions: ${BASE_EDITIONS}" >&2
			exit 1
		fi
	elif [ -n "${BASE_EDITION}" ]; then
		echo $"ERROR! ${BASE_OS} does not have base editions." >&2
		exit 1
	fi
}


function list_json() {
	# Reference: https://stackoverflow.com/a/67359273
	list_csv | jq -R 'split(",") as $h|reduce inputs as $in ([]; . += [$in|split(",")|. as $a|reduce range(0,length) as $i ({};.[$h[$i]]=$a[$i])])'
	exit 0
}

function list_csv() {
	CSV_DATA="$(csv_data)"
	echo "Display Name,OS,Release,Option,Downloader,PNG,SVG"
	sort -t',' -k2,2 <<<"${CSV_DATA}"
	exit 0
}

