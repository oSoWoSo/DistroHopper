function csv_data() {
	local DISPLAY_NAME
	local DL=""
	local DOWNLOADER
	local FUNC
	local OPTION
	local OS
	local PNG
	local RELEASE
	local SVG
	local HAS_ZSYNC=0
	local OSNAME
	local PRETTY
	local ICON
	local CATEGORY
	local BASEDOF
	local HOMEPAGE
	local CREDENTIALS
	local DESCRIPTION
	# Check if zsync is available
	if command -v zsync &>/dev/null; then
		HAS_ZSYNC=1
	fi

	for OS in $(os_support); do
		dh_load_os "${OS}"
		DISPLAY_NAME="${PRETTY}"
		SVG="" PNG=""
		if [[ "${ICON}" == *.svg ]]; then
			SVG="https://dh.osowoso.org/icons/${ICON}"
		elif [[ "${ICON}" == *.png ]]; then
			PNG="https://dh.osowoso.org/icons/${ICON}"
		else
			PNG="-"
		fi

		# The editions of this distro. EDITIONS is set by dh_load_os from the
		# generated metadata; do not shadow it with a local variable.
		local EDITIONS_LIST=""
		if [[ $(type -t editions_) == function ]] || [ -n "${EDITIONS:-}" ]; then
			EDITIONS_LIST=$(dh_editions "")
		fi

		for RELEASE in $(dh_releases ""); do
			if [[ "${OS}" == *"ubuntu"* ]] && [[ ${RELEASE} == *"daily"*  ]] && [ ${HAS_ZSYNC} -eq 1 ]; then
				DOWNLOADER="zsync"
			else
				DOWNLOADER="${DL}"
			fi

			# Editions may depend on the release (kde-neon, fedora-linux, zorin), so
			# re-evaluate them for the release currently being listed.
			local RELEASE_EDITIONS="${EDITIONS_LIST}"
			if [[ $(type -t editions_) == function ]] || [ -n "${EDITIONS:-}" ]; then
				RELEASE_EDITIONS=$(dh_editions "${RELEASE}" "${ARCH:-}")
			fi

			# If the OS has an editions_() function, use it.
			if [[ ${RELEASE_EDITIONS} ]]; then
				for OPTION in ${RELEASE_EDITIONS}; do
					echo "${DISPLAY_NAME},${OS},${RELEASE},${OPTION},${DOWNLOADER},${PNG},${SVG}"
				done
			elif [[ "${OS}" == "windows"* ]] && [[ $(type -t languages_) == function ]]; then
				languages_
				for I18N in "${I18NS[@]}"; do
					echo "${DISPLAY_NAME},${OS},${RELEASE},${I18N},${DOWNLOADER},${PNG},${SVG}"
				done
			else
				echo "${DISPLAY_NAME},${OS},${RELEASE},,${DOWNLOADER},${PNG},${SVG}"
			fi
		done &
	done
	wait
}

# list_supported — output "OS RELEASE EDITION" rows.
# Defined once, after list_csv/csv_data, so the CSV pipeline stays the single
# source of truth for the distro metadata.
function list_supported() {
	# The CSV row is "OS,RELEASE,EDITION,...". An empty edition must stay
	# empty — turning it into "-" would print a placeholder that is not a
	# real edition.
	list_csv | tail -n +2 | cut -d ',' -f2,3,4 | while IFS= read -r row; do
		printf '%s\n' "${row//,/$'\t'}" | tr '\t' ' '
	done
	exit 0
}

